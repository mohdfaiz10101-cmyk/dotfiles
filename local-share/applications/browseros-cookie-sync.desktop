[Desktop Entry]
Actions=new-private-window;new-window
Categories=Network;WebBrowser
Exec=/home/charlie/.local/bin/browser-launch-with-cookies browseros %U
GenericName=AI Browser (with Cookie Sync)
Icon=/home/charlie/Apps/BrowserOS.AppImage
MimeType=text/html;text/xml;application/xhtml+xml;application/vnd.mozilla.xul+xml;x-scheme-handler/http;x-scheme-handler/https
Name=BrowserOS (Cookie Sync)
StartupNotify=true
StartupWMClass=browseros
Terminal=false
Type=Application
Version=1.5

[Desktop Action new-private-window]
Exec=/home/charlie/.local/bin/browser-launch-with-cookies browseros --incognito %U
Name=New Incognito Window

[Desktop Action new-window]
Exec=/home/charlie/.local/bin/browser-launch-with-cookies browseros --new-window %U
Name=New Window
