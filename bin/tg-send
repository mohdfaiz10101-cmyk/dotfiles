#!/usr/bin/env bash
# tg-send — 快速发 Telegram 消息
# 用法:
#   tg-send "消息内容"
#   tg-send "标题" "消息内容"
#   echo "内容" | tg-send
#   tg-send --chat 123456 "指定chat_id"
#   tg-send --file /path/to/file "说明"
#   tg-send --photo /path/to/img "说明"

BOT_TOKEN="8797063873:AAGvApEP9frmA74b6nmxODHshzo1TwJR5ks"
DEFAULT_CHAT="5036541266"
PROXY="${HTTPS_PROXY:-http://127.0.0.1:7890}"

CHAT_ID="$DEFAULT_CHAT"
MODE="text"
FILE_PATH=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --chat)   CHAT_ID="$2"; shift 2 ;;
        --photo)  MODE="photo"; FILE_PATH="$2"; shift 2 ;;
        --file)   MODE="document"; FILE_PATH="$2"; shift 2 ;;
        --help|-h)
            echo "用法: tg-send [选项] [消息]"
            echo "  tg-send \"消息\""
            echo "  tg-send --chat ID \"消息\""
            echo "  tg-send --photo img.jpg \"说明\""
            echo "  tg-send --file file.txt \"说明\""
            echo "  echo \"内容\" | tg-send"
            exit 0 ;;
        *) break ;;
    esac
done

# 读消息：参数 or stdin
if [[ -n "$1" ]]; then
    MSG="$*"
elif [[ ! -t 0 ]]; then
    MSG="$(cat)"
else
    echo "[FAIL] 缺少消息内容" >&2; exit 1
fi

[[ -z "$MSG" ]] && exit 0

send_text() {
    curl -sS --proxy "$PROXY" -X POST \
        "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
        -d chat_id="$CHAT_ID" \
        -d parse_mode="HTML" \
        -d text="$1" | python3 -c "
import sys,json
d=json.load(sys.stdin)
if d.get('ok'): print(f'[OK] → msg_id={d[\"result\"][\"message_id\"]}')
else: print(f'[FAIL] {d.get(\"description\",\"unknown\")}',file=sys.stderr); sys.exit(1)
"
}

send_photo() {
    local caption="$1"
    local file="$2"
    curl -sS --proxy "$PROXY" -X POST \
        "https://api.telegram.org/bot${BOT_TOKEN}/sendPhoto" \
        -F chat_id="$CHAT_ID" \
        -F photo="@$file" \
        -F parse_mode="HTML" \
        -F caption="$caption" | python3 -c "
import sys,json
d=json.load(sys.stdin)
if d.get('ok'): print(f'[OK] → msg_id={d[\"result\"][\"message_id\"]}')
else: print(f'[FAIL] {d.get(\"description\",\"unknown\")}',file=sys.stderr); sys.exit(1)
"
}

send_document() {
    local caption="$1"
    local file="$2"
    curl -sS --proxy "$PROXY" -X POST \
        "https://api.telegram.org/bot${BOT_TOKEN}/sendDocument" \
        -F chat_id="$CHAT_ID" \
        -F document="@$file" \
        -F parse_mode="HTML" \
        -F caption="$caption" | python3 -c "
import sys,json
d=json.load(sys.stdin)
if d.get('ok'): print(f'[OK] → msg_id={d[\"result\"][\"message_id\"]}')
else: print(f'[FAIL] {d.get(\"description\",\"unknown\")}',file=sys.stderr); sys.exit(1)
"
}

case "$MODE" in
    text)     send_text "$MSG" ;;
    photo)    send_photo "$MSG" "$FILE_PATH" ;;
    document) send_document "$MSG" "$FILE_PATH" ;;
esac
