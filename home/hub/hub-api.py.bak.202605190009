def dialogue_append(sender: str, content: str, msg_type: str = "message") -> None:
    """外部脚本调用此函数广播消息（也可直接追加文件）。"""
    entry = {
        "ts": time.strftime("%H:%M:%S"),
        "from": sender,
        "type": msg_type,
        "content": content,
    }
    with open(DIALOGUE_FEED, "a") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")


