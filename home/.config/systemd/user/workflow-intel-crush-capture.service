[Unit]
Description=Capture Crush workflow events

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
TimeoutStartSec=2min
ExecStart=/var/home/charlie/.local/bin/workflow-intel capture --source crush --limit 50
ExecStart=/var/home/charlie/.local/bin/workflow-intel extract --limit 200
