[Service]
Type=simple
Environment=PATH=/var/home/charlie/.nvm/versions/node/v22.22.3/bin:/var/home/charlie/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/ttyd -W -t rendererType=dom -p 17767 -i 100.120.189.27 -T xterm-256color /var/home/charlie/.local/bin/crush-ttyd-entry
