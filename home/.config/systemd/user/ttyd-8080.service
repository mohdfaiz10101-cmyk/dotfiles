[Unit]
Description=OpenClaw ttyd (:8080)
After=network-online.target opencode.service
Wants=network-online.target opencode.service

[Service]
Type=simple
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/ttyd -W -t "rendererType=dom" -p 8080 -i 0.0.0.0 -T xterm-256color /var/home/charlie/.local/bin/ttyd-openclaw-entry
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
