# /var/home/charlie/.config/systemd/user/system-log-scan.service
[Unit]
Description=Scan collected logs for errors
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /var/home/charlie/.hermes/skills/devops/system-log-monitoring/scripts/scan-log-errors.py /var/home/charlie/workspace/system-logs
Environment=BASE_DIR=/var/home/charlie/workspace/system-logs
Environment=NOTIFY_STATE=/var/home/charlie/.local/state/system-log-monitoring/notified.jsonl
