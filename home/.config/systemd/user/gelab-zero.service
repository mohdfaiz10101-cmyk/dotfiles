[Unit]
Description=Gelab-Zero Copilot Panel (Streamlit :33503)
After=default.target

[Service]
Type=simple
WorkingDirectory=/mnt/ai/apps/gelab-zero
ExecStart=/usr/bin/python3 -m streamlit run --server.address 0.0.0.0 --server.headless true visualization/main_page.py --server.port 33503
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
