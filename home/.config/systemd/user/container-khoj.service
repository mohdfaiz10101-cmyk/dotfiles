[Unit]
Description=Podman container-khoj.service
After=container-letta-db.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/podman rm -f khoj
ExecStart=/usr/bin/podman run --rm \
  --name khoj \
  --network host \
  -v /mnt/ai/data/khoj/data:/root/.khoj:Z \
  -v /mnt/ai/data/khoj/models:/root/.cache/torch/sentence_transformers \
  -v /var/home/charlie/memory:/root/memory:ro \
  -e KHOJ_NO_HTTPS=True \
  -e KHOJ_ADMIN_EMAIL=admin@local \
  -e KHOJ_ADMIN_PASSWORD=khoj-local-2026 \
  -e DATABASE_URL=postgresql://postgres:khoj-secret@127.0.0.1:5432/khoj \
  ghcr.io/khoj-ai/khoj:latest \
  --host 127.0.0.1 --port 42110 --non-interactive --anonymous-mode
ExecStop=/usr/bin/podman stop khoj
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target