[Unit]
Description=ttyd — Agent Hub Web Terminal
After=network-online.target graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=HOME=%h
Environment=NVM_DIR=%h/.nvm
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:%h/.nvm/versions/node/v22.22.3/bin:/usr/bin:/bin
ExecStartPre=/bin/bash -c 'source %h/.nvm/nvm.sh && nvm use v22.22.3 --silent || true'
ExecStart=/usr/local/bin/ttyd -p 7681 -i 127.0.0.1 -W tmux attach -t agent-hub
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
