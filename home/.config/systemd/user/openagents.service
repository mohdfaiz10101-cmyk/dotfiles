[Unit]
Description=OpenAgents Network Daemon
After=network-online.target openclaw-gateway.service
Wants=network-online.target

OnFailure=sentinel-onfailure@openagents.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=simple
ExecStartPre=-/bin/sh -c 'ss -tlnp | grep -q ":8700 " && echo "PORT 8700 IN USE" && exit 1 || true'
ExecStart=/home/charlie/.local/bin/openagents network start
Restart=always
RestartSec=10
Environment=HOME=/home/charlie
Environment=PATH=/home/charlie/.local/bin:/run/current-system/sw/bin
Environment=OPENAGENTS_PORT=8700

[Install]
WantedBy=default.target


