[Unit]
Description=noVNC desktop view public HTTPS entry on 19986
After=network-online.target wayvnc-desktop.service
Wants=network-online.target wayvnc-desktop.service

[Service]
Type=simple
ExecStart=%h/.local/bin/caddy run --config %h/.config/caddy/wayvnc-desktop.Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=4
Environment=HOME=%h
UMask=0077
MemoryMax=180M

[Install]
WantedBy=default.target
