[Unit]
Description=Hermes Smart Profile Proxy (Host-based profile mapping)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /var/home/charlie/.local/bin/hermes-smart-proxy.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
