[Unit]
Description=Private Windows WeChat backup storage on Fedora
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
StartLimitBurst=3

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f wechat-backup-smb
ExecStart=/var/home/charlie/.local/bin/wechat-backup-smb-run
ExecStop=/usr/bin/docker stop -t 10 wechat-backup-smb
Restart=on-failure
RestartSec=30
TimeoutStopSec=30

[Install]
WantedBy=default.target
