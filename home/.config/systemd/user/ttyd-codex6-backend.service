[Unit]
Description=Codex 6 TTY backend (haven-codex6, :20020)
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ttyd -W -c codex:w19900422 -I /var/home/charlie/.local/share/ttyd-codex/index-codex6.html -t "rendererType=dom" -t "scrollback=50000" -t "scrollOnUserInput=true" -P 15 -p 20020 -i 127.0.0.1 -T xterm-256color /var/home/charlie/.local/bin/ttyd-codex6-entry
Restart=always
RestartSec=2s

[Install]
WantedBy=default.target
