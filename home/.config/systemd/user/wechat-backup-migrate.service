[Unit]
Description=Incrementally copy Windows iOS WeChat backup to Fedora (never delete source)
After=wechat-backup-smb.service
Requires=wechat-backup-smb.service

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh -o BatchMode=yes -o ConnectTimeout=10 -o ConnectionAttempts=1 -o ServerAliveInterval=15 -o ServerAliveCountMax=6 -p 2222 G@127.0.0.1 python C:/WeChatSync/fedora-backup-copy.py
TimeoutStartSec=infinity
Nice=10
