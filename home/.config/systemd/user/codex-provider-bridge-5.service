[Unit]
Description=Codex Provider Bridge (instance 5)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/codex-provider-bridge-5
ExecStart=%h/.local/share/codex-provider-bridge-5/.venv/bin/python %h/.local/share/codex-provider-bridge-5/main.py --auth auto
Restart=always
RestartSec=2
Environment=HTTP_PROXY=http://127.0.0.1:7890
Environment=HTTPS_PROXY=http://127.0.0.1:7890
Environment=NO_PROXY=localhost,127.0.0.1,::1
Environment=HOST=127.0.0.1
Environment=PORT=8005

[Install]
WantedBy=default.target
