[Unit]
Description=TCP Keepalive Proxy for SSH 2235 (Codex 8)
After=network-online.target

[Service]
Type=simple
ExecStart=/var/home/charlie/.local/bin/tcp-keepalive-proxy-public 2235 127.0.0.1 22044
Restart=always
RestartSec=5
LimitNPROC=8192
StandardOutput=journal

[Install]
WantedBy=default.target
