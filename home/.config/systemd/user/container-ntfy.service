[Unit]
Description=ntfy push notification server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/var/home/charlie/.local/bin/ntfy-server serve --config /var/home/charlie/ai/ntfy/etc/server-local.yml
Restart=always
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=default.target
