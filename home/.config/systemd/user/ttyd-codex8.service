[Unit]
Description=Codex 8 WebTTY device gate - socket activated
Requires=ttyd-codex8.socket
After=network-online.target ttyd-codex8-backend.service
Wants=ttyd-codex8-backend.service

[Service]
Type=simple
Environment=HOME=%h
Environment=PATH=%h/.nvm/versions/node/current/bin:%h/.cargo/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TTYD_TARGET_HOST=127.0.0.1
Environment=TTYD_TARGET_PORT=19888
Environment=TTYD_TARGET_AUTH=codex:w19900422
Environment=DEVICE_MATCH_CODE=w19900422
Environment=DEVICE_COOKIE_NAME=duckdns_codex8_device
Environment=CODEX_ACCOUNT_ID="8"
Environment=CODEX_ACCOUNT_LABEL="Codex 8"
ExecStart=/var/home/charlie/.local/bin/ttyd-device-gate-proxy
Restart=always
RestartSec=3
