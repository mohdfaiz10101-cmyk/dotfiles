[Unit]
Description=OpenCode Bridge (4096)
After=network-online.target
PartOf=graphical-session.target
[Service]
Type=simple
Environment=PATH=/var/home/charlie/.nvm/versions/node/v22.22.3/bin:/usr/bin:/bin
ExecStart=/var/home/charlie/.nvm/versions/node/v22.22.3/bin/opencode serve --port 4096 --hostname 0.0.0.0
Restart=on-failure
RestartSec=5
[Install]
WantedBy=graphical-session.target