[Unit]
Description=Hermes idle task scheduler (process queued heavy tasks when system is idle)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=%h
Environment=HERMES_HOME=%h/.hermes
Environment=NTFY_TOPIC_SYSTEM=charlie-system
ExecStart=%h/.local/bin/hermes-idle-scheduler.sh run

# Run from user home so relative paths work
WorkingDirectory=%h
