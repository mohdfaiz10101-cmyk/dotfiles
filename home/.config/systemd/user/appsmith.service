[Unit]
Description=Appsmith unified operations console
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/var/home/charlie/apps/appsmith
ExecStart=/usr/bin/docker compose up -d
ExecStartPost=/var/home/charlie/apps/appsmith/configure-control-plane.sh
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=default.target
