[Unit]
Description=Codex 5 TTY backend (haven-codex5, :19889)
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ttyd -W -c codex:w19900422 -I /var/home/charlie/.local/share/ttyd-codex/index-codex5.html -t "rendererType=canvas" -t "scrollback=50000" -t "scrollOnUserInput=true" -P 15 -p 19889 -i 127.0.0.1 -T xterm-256color /var/home/charlie/.local/bin/ttyd-codex5-entry
Restart=always
RestartSec=2s

[Install]
WantedBy=default.target
