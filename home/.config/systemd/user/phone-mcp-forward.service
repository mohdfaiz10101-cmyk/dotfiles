[Unit]
Description=Phone MCP TCP forwarder (desktop 19080 -> phone 8080)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /var/home/charlie/workspace/phone-mcp-forward.py
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
