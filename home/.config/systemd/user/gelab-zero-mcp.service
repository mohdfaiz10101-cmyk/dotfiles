[Unit]
Description=GELab-Zero MCP Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/ai/apps/gelab-zero
ExecStart=/usr/bin/python3 /mnt/ai/apps/gelab-zero/mcp_server/simple_gelab_mcp_server.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/mnt/ai/apps/gelab-zero

[Install]
WantedBy=default.target
