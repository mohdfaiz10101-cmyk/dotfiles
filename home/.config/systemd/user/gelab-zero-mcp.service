[Unit]
Description=GELab-Zero MCP Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/home/charlie/.local/share/gelab-zero
ExecStart=/usr/bin/python3 /var/home/charlie/.local/share/gelab-zero/mcp_server/simple_gelab_mcp_server.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
