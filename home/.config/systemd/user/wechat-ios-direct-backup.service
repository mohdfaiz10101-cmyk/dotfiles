[Unit]
Description=Acquire source iPhone WeChat data directly onto Fedora

[Service]
Type=oneshot
ExecStart=/var/home/charlie/.local/bin/wechat-ios-direct-backup --backup --wechat-only --reacquire-missing
TimeoutStartSec=infinity
TimeoutStopSec=25
KillMode=control-group
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
