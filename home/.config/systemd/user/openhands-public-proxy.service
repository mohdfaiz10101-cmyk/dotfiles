[Unit]
Description=OpenHands public BasicAuth proxy (:13001 -> :3001)
After=openhands-gui.service

[Service]
Type=simple
Environment=OPENHANDS_PUBLIC_HOST=127.0.0.1
Environment=OPENHANDS_PUBLIC_PORT=13001
Environment=OPENHANDS_TARGET_HOST=127.0.0.1
Environment=OPENHANDS_TARGET_PORT=3001
Environment=OPENHANDS_PUBLIC_USER=openhands
Environment=OPENHANDS_PUBLIC_PASSWORD=w19900422
ExecStart=%h/.local/bin/openhands-public-proxy
Restart=on-failure
RestartSec=3
MemoryMax=256M

[Install]
WantedBy=default.target
