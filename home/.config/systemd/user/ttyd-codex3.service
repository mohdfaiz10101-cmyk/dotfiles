[Unit]
Description=Codex 3 WebTTY device gate (:19002)
After=network-online.target ttyd-codex3-backend.service
Wants=ttyd-codex3-backend.service

[Service]
Type=simple
Environment=TTYD_GATE_PORT=19002
Environment=TTYD_TARGET_PORT=19883
Environment=TTYD_TARGET_AUTH=codex:w19900422
Environment=DEVICE_MATCH_CODE=w19900422
Environment=DEVICE_COOKIE_NAME=duckdns_codex3_device
Environment=CODEX_ACCOUNT_ID=3
Environment="CODEX_ACCOUNT_LABEL=Codex 3"
ExecStart=/var/home/charlie/.local/bin/ttyd-device-gate-proxy
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
