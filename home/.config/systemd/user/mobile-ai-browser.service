[Unit]
Description=Mobile AI Workbench controlled Chromium browser
After=graphical-session.target network-online.target mobile-ai-workbench.service

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=MOBILE_AI_BROWSER_CDP_HOST=127.0.0.1
Environment=MOBILE_AI_BROWSER_CDP_PORT=9224
ExecStartPre=%h/.local/bin/google-login-state-sync %h/.config/mobile-ai-chromium
ExecStart=%h/.local/bin/mobile-ai-browser
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
