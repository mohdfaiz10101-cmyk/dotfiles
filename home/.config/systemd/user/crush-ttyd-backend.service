[Unit]
Description=Crush native WebTTY backend (:7767)
After=network-online.target crush-tailscale.service
Wants=network-online.target crush-tailscale.service

[Service]
Type=simple
Environment=PATH=/var/home/charlie/.nvm/versions/node/v22.22.3/bin:/var/home/charlie/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/ttyd -W -t rendererType=dom -t fontSize=16 -P 15 -p 7767 -i 127.0.0.1 -T xterm-256color /var/home/charlie/.local/bin/crush-ttyd-entry
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
