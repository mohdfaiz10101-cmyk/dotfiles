[Unit]
Description=Codex 4 WebTTY device gate (:19003)
After=network-online.target ttyd-codex4-backend.service
Wants=ttyd-codex4-backend.service

[Service]
Type=simple
Environment=TTYD_GATE_PORT=19003
Environment=TTYD_TARGET_PORT=19884
Environment=TTYD_TARGET_AUTH=codex:w19900422
Environment=DEVICE_MATCH_CODE=w19900422
Environment=DEVICE_COOKIE_NAME=duckdns_codex4_device
Environment=CODEX_ACCOUNT_ID=4
Environment="CODEX_ACCOUNT_LABEL=Codex 4"
ExecStart=/var/home/charlie/.local/bin/ttyd-device-gate-proxy
Restart=always
RestartSec=2

[Install]
WantedBy=default.target