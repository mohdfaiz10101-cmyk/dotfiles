[Unit]
Description=Redroid Lite VM (Ubuntu 24.04 Server)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
ExecStart=/usr/bin/qemu-system-x86_64 \
  -enable-kvm -machine q35,accel=kvm,kernel_irqchip=split -cpu host,+nx,+kvm_pv_eoi,+kvm_pv_unhalt -smp 2 -m 2048 \
  -drive file=/var/mnt/ai/redroid-vm/ubuntu-24.04-server-cloudimg-amd64-overlay.qcow2,if=virtio,cache=writeback,discard=ignore,format=qcow2 \
  -drive file=/var/mnt/ai/redroid-vm/seed.iso,if=virtio,media=cdrom,readonly=on \
  -device virtio-net-pci,netdev=net0,mac=52:54:00:12:34:57 \
  -netdev user,id=net0,hostfwd=tcp::22222-:22,hostfwd=tcp::25555-:5555 \
  -display none -vga qxl \
  -daemonize -pidfile /var/mnt/ai/redroid-vm/redroid-lite.pid
ExecStop=/bin/sh -c 'kill $(cat /var/mnt/ai/redroid-vm/redroid-lite.pid 2>/dev/null) 2>/dev/null || true; rm -f /var/mnt/ai/redroid-vm/redroid-lite.pid'
Restart=on-failure
RestartSec=2
PIDFile=/var/mnt/ai/redroid-vm/redroid-lite.pid

[Install]
WantedBy=default.target
