[Unit]
Description=TCP Keepalive Proxy for SSH 2231 (Codex 4)
After=network-online.target

[Service]
Type=simple
ExecStart=/var/home/charlie/.local/bin/tcp-keepalive-proxy-public 2231 127.0.0.1 22036
Restart=always
RestartSec=5
LimitNPROC=8192
StandardOutput=journal

[Install]
WantedBy=default.target
