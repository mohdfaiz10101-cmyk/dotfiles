[Unit]
Description=TCP Keepalive Proxy for SSH 2237 (Codex 10)
After=network-online.target

[Service]
Type=simple
ExecStart=/var/home/charlie/.local/bin/tcp-keepalive-proxy-public 2237 127.0.0.1 22048
Restart=always
RestartSec=5
LimitNPROC=8192
StandardOutput=journal

[Install]
WantedBy=default.target
