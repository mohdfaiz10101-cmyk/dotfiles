[Unit]
Description=OpenCode Web Proxy (4096, inject TTY button)
After=opencode.service
Requires=opencode.service
# PartOf=graphical-session.target removed — proxy should survive graphical session restarts

[Service]
Type=simple
Environment=PATH=/var/home/charlie/.nvm/versions/node/v22.22.3/bin:/usr/bin:/bin
Environment=OPENCODE_PROXY_HOST=0.0.0.0
Environment=OPENCODE_PROXY_PORT=4096
Environment=OPENCODE_TARGET_HOST=127.0.0.1
Environment=OPENCODE_TARGET_PORT=4097
ExecStart=/var/home/charlie/.local/bin/opencode-4096-proxy
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
