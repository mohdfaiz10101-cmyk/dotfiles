[Unit]
Description=SHA256 manifest of original Windows WeChat iOS backup

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh -o BatchMode=yes -o ConnectTimeout=10 -o ConnectionAttempts=1 -o ServerAliveInterval=15 -p 2222 G@127.0.0.1 python C:/WeChatSync/fedora-backup-manifest.py
TimeoutStartSec=infinity
Nice=15
