[Unit]
Description=TCP Keepalive Proxy for SSH 2236 (Codex 9)
After=network-online.target

[Service]
Type=simple
ExecStart=/var/home/charlie/.local/bin/tcp-keepalive-proxy-public 2236 127.0.0.1 22046
Restart=always
RestartSec=5
LimitNPROC=8192
StandardOutput=journal

[Install]
WantedBy=default.target
