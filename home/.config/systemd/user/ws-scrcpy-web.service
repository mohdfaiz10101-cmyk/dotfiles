[Unit]
Description=WsScrcpyWeb - Browser-based Android screen mirroring
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/var/home/charlie/.local/share/WsScrcpyWeb/start-live.sh
Environment=ADB_SERIAL=127.0.0.1:15556
Environment=ADB_MDNS_AUTO_CONNECT=0
Environment=ANDROID_ADB_SERVER_PORT=5039
Restart=always
RestartSec=2
WorkingDirectory=/var/home/charlie/.local/share/WsScrcpyWeb

[Install]
WantedBy=default.target
