[Unit]
Description=Weekly verified cold backup to 固态便携
After=local-fs.target
# 冷备依赖 sdf2 已插入，未插入时失败是预期的
ConditionPathExists=%h/.local/bin/cold-backup-to-usb.sh

[Service]
Type=oneshot
ExecStart=%h/.local/bin/cold-backup-to-usb.sh
StandardOutput=journal
StandardError=journal
# 低优先级，避免与桌面会话争 IO
Nice=15
IOSchedulingClass=idle
# 打包+校验+写入上限 2 小时
TimeoutStartSec=2h
# 盘未插入时不要刷屏
SuccessExitStatus=0
