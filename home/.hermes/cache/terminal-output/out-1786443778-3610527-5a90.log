== /var/home/charlie/.local/bin/adb-phone-keepalive.sh ==
#!/usr/bin/env bash
set -u

HOME_DIR="${HOME:-/var/home/charlie}"
ADB="${ADB_BIN:-$HOME_DIR/.local/bin/adb}"
STATE_DIR="$HOME_DIR/.local/state/adb-phone-keepalive"
STATE="$STATE_DIR/latest.json"
LOG="$STATE_DIR/keepalive.log"
mkdir -p "$STATE_DIR"

TCP_CANDIDATES=(
  "127.0.0.1:15555"
  "192.168.123.22:5555"
  "100.87.37.3:5555"
)

ts() { date '+%F %T'; }
log() { printf '[%s] %s\n' "$(ts)" "$*" >> "$LOG"; }
adb_run() { timeout "${ADB_TIMEOUT:-12}" "$ADB" "$@" 2>&1; }

connect_tcp_candidates() {
  local serial
  "$ADB" start-server >/dev/null 2>&1 || true
  for serial in "${TCP_CANDIDATES[@]}"; do
    timeout -k 2s 6s "$ADB" connect "$serial" >/dev/null 2>&1 || true
  done
}

device_lines() {
  "$ADB" devices -l 2>/dev/null | awk '
    $2=="device" {
      line=$0
      if (line !~ /product:redroid/ && line !~ /model:redroid/ && line !~ /waydroid/) print line
    }'
}

choose_serial() {
  local lines serial cand
  lines="$(device_lines)"
  [ -n "$lines" ] || return 1
  for cand in "${TCP_CANDIDATES[@]}"; do
    serial="$(printf '%s\n' "$lines" | awk -v s="$cand" '$1==s {print $1; exit}')"
    [ -z "$serial" ] || { printf '%s\n' "$serial"; return 0; }
  done
  printf '%s\n' "$lines" | awk '{print $1; exit}'
}

shell_su() {
  local serial="$1"
  local script="$2"
  adb_run -s "$serial" shell "su -c '$script'" || true
}

uid_for() {
  local serial="$1"
  local pkg="$2"
  adb_run -s "$serial" shell "cmd package list packages -U $pkg" |
    tr -d '\r' |
    awk -F'uid:' '{print $2}' |
    awk 'NF{print $1; exit}'
}

allow_pkg() {
  local serial="$1"
  local pkg="$2"
  local uid
  shell_su "$serial" "cmd package enable --user 0 $pkg >/dev/null 2>&1"
  shell_su "$serial" "cmd deviceidle whitelist +$pkg >/dev/null 2>&1"
  shell_su "$serial" "appops set $pkg RUN_IN_BACKGROUND allow >/dev/null 2>&1; appops set $pkg RUN_ANY_IN_BACKGROUND allow >/dev/null 2>&1; appops set $pkg WAKE_LOCK allow >/dev/null 2>&1; appops set $pkg POST_NOTIFICATION allow >/dev/null 2>&1"
  uid="$(uid_for "$serial" "$pkg" || true)"
  if [ -n "$uid" ]; then
    shell_su "$serial" "cmd netpolicy add restrict-background-whitelist $uid >/dev/null 2>&1"
  fi
}

ensure_phone() {
  local serial="$1"
  log "selected serial=$serial"

  case "$serial" in
    127.0.0.1:15555|localhost:15555)
      log "skip adb tcpip on frp serial=$serial"
      ;;
    *)
      adb_run -s "$serial" tcpip 5555 >/dev/null || true
      ;;
  esac

  shell_su "$serial" "settings put global always_on_vpn_app io.netbird.client; settings put global always_on_vpn_lockdown 0"
  allow_pkg "$serial" "io.netbird.client"
  allow_pkg "$serial" "sh.haven.app"
  allow_pkg "$serial" "io.heckel.ntfy"
  allow_pkg "$serial" "org.kde.kdeconnect_tp"

  shell_su "$serial" "pgrep -f '/data/local/tmp/frpc_smart.sh' >/dev/null 2>&1 || { test -x /data/local/tmp/frpc_smart.sh && sh /data/local/tmp/frpc_smart.sh >/data/local/tmp/frpc.log 2>&1 & }"
  shell_su "$serial" "pgrep -f '/data/local/tmp/frpc_smart.sh' >/dev/null 2>&1 || { test -f /data/adb/service.d/frpc.sh && sh /data/adb/service.d/frpc.sh >/data/local/tmp/frpc_boot.log 2>&1 & }"
  if [ "${ADB_KEEPALIVE_ALLOW_NETBIRD_FOREGROUND:-0}" = "1" ]; then
    shell_su "$serial" "monkey -p io.netbird.client -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1"
  else
    log "skip netbird foreground; set ADB_KEEPALIVE_ALLOW_NETBIRD_FOREGROUND=1 for explicit repair"
  fi
}

main() {
  local serial devices frp_ok netbird_app
  connect_tcp_candidates
  serial="$(choose_serial || true)"
  devices="$("$ADB" devices -l 2>/dev/null | sed '1d' | tr '\n' ';' | sed 's/"/\\"/g')"
  if [ -z "$serial" ]; then
    printf '{"ok":false,"reason":"no-device","devices":"%s","ts":"%s"}\n' "$devices" "$(ts)" > "$STATE"
    log "no-device devices=$devices"
    return 0
  fi

  ensure_phone "$serial"
  sleep 2
  timeout -k 2s 6s "$ADB" connect 127.0.0.1:15555 >/dev/null 2>&1 || true
  frp_ok="$("$ADB" devices 2>/dev/null | awk '$1=="127.0.0.1:15555" && $2=="device"{print "true"}' | head -n 1)"
  [ -n "$frp_ok" ] || frp_ok=false
  netbird_app="$(adb_run -s "$serial" shell 'settings get global always_on_vpn_app' | tr -d '\r' | head -n 1 | sed 's/"/\\"/g')"
  printf '{"ok":true,"serial":"%s","frp_adb":%s,"always_on_vpn_app":"%s","ts":"%s"}\n' "$serial" "$frp_ok" "$netbird_app" "$(ts)" > "$STATE"
  log "ok serial=$serial frp_adb=$frp_ok always_on_vpn_app=$netbird_app"
}

main "$@"

