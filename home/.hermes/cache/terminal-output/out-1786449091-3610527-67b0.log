540: 
541:     Raw file copy on purpose: the DB won't open cleanly, so we preserve the
542:     bytes exactly for forensics / manual restore. WAL and SHM sidecars are
543:     copied too when present. Returns the backup path, or None on failure.
544:     """
545:     import datetime
546:     import shutil
547: 
548:     stamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
549:     backup_path = db_path.with_name(f"{db_path.name}.malformed-backup-{stamp}")
550:     try:
551:         shutil.copy2(db_path, backup_path)
552:         for suffix in ("-wal", "-shm"):
553:             sidecar = db_path.with_name(db_path.name + suffix)
554:             if sidecar.exists():
555:                 shutil.copy2(sidecar, backup_path.with_name(backup_path.name + suffix))
556:         return backup_path
557:     except Exception as exc:  # pragma: no cover - best effort
558:         logger.warning("Could not back up malformed DB %s: %s", db_path, exc)
559:         return None
