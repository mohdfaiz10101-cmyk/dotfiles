#!/bin/bash
set -e

export HOME=/var/home/charlie
export CODEX_HOME=/var/home/charlie/.codex
export XDG_RUNTIME_DIR=/run/user/1000
export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
export PATH=/var/home/charlie/.nvm/versions/node/v22.22.3/bin:/var/home/charlie/.local/bin:/usr/bin:/bin
export HTTP_PROXY=http://127.0.0.1:7890
export HTTPS_PROXY=http://127.0.0.1:7890
export ALL_PROXY=http://127.0.0.1:7890
export NO_PROXY=localhost,127.0.0.1,0.0.0.0,::1,192.168.123.0/24,100.64.0.0/10,.ts.net
export http_proxy="$HTTP_PROXY"
export https_proxy="$HTTPS_PROXY"
export all_proxy="$ALL_PROXY"
export no_proxy="$NO_PROXY"
export CODEX_TOKEN_SAFE_RUN=/var/home/charlie/.local/bin/codex-token-safe-run
export BASH_ENV=/var/home/charlie/.config/codex-shell-env/env.sh
export ENV=/var/home/charlie/.config/codex-shell-env/env.sh
export ZDOTDIR=/var/home/charlie/.config/codex-shell-env
if [ -z "${TERM:-}" ] || [ "$TERM" = "dumb" ]; then
    export TERM=xterm-256color
fi

cd /var/home/charlie

SESSION="haven-codex"
TMUX_SOCK="$XDG_RUNTIME_DIR/tmux/codex.sock"
CODEX_BIN="/var/home/charlie/.local/bin/codex-resume-or-new"
mkdir -p "$(dirname "$TMUX_SOCK")"

session_has_live_pane() {
    tmux -S "$TMUX_SOCK" list-panes -t "$SESSION" -F '#{pane_dead}' 2>/dev/null | grep -q '^0$'
}

create_session() {
    tmux -S "$TMUX_SOCK" new-session -d -s "$SESSION" -c /var/home/charlie \
        -e "TERM=tmux-256color" \
        -e "HOME=$HOME" \
        -e "CODEX_HOME=$CODEX_HOME" \
        -e "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR" \
        -e "DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS" \
        -e "PATH=$PATH" \
        -e "HTTP_PROXY=$HTTP_PROXY" \
        -e "HTTPS_PROXY=$HTTPS_PROXY" \
        -e "ALL_PROXY=$ALL_PROXY" \
        -e "NO_PROXY=$NO_PROXY" \
        -e "http_proxy=$http_proxy" \
        -e "https_proxy=$https_proxy" \
        -e "all_proxy=$all_proxy" \
        -e "no_proxy=$no_proxy" \
        -e "CODEX_TOKEN_SAFE_RUN=$CODEX_TOKEN_SAFE_RUN" \
        -e "BASH_ENV=$BASH_ENV" \
        -e "ENV=$ENV" \
        -e "ZDOTDIR=$ZDOTDIR" \
        "$CODEX_BIN"
    tmux -S "$TMUX_SOCK" set-option -g history-limit 50000
    tmux -S "$TMUX_SOCK" set-option -g mouse off
    tmux -S "$TMUX_SOCK" set-option -t "$SESSION" remain-on-exit off
    tmux -S "$TMUX_SOCK" set-option -t "$SESSION" allow-passthrough off 2>/dev/null || true
    tmux -S "$TMUX_SOCK" set-option -t "$SESSION" extended-keys off 2>/dev/null || true
}

if tmux -S "$TMUX_SOCK" has-session -t "$SESSION" 2>/dev/null; then
    if ! session_has_live_pane; then
        tmux -S "$TMUX_SOCK" kill-session -t "$SESSION" 2>/dev/null || true
        create_session
    fi
else
    create_session
fi

tmux -S "$TMUX_SOCK" set-option -g history-limit 50000
tmux -S "$TMUX_SOCK" set-option -g mouse off
printf '\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?1004l'
exec tmux -S "$TMUX_SOCK" attach-session -t "$SESSION"

