/var/home/charlie/.hermes/sessions/request_dump_mrw8lc7unh9ypw_20260723_001339_244936.json:796:                "arguments": "{\"content\":\"#!/usr/bin/env python3\\nimport json\\nimport os\\nimport sqlite3\\nfrom pathlib import Path\\nfrom datetime import datetime\\n\\nBASE = Path('/var/home/charlie/phone-sync')\\nINBOX = BASE / 'inbox'\\nDBDIR = BASE / 'db'\\nDBDIR.mkdir(parents=True, exist_ok=True)\\nINBOX.mkdir(parents=True, exist_ok=True)\\nDB = DBDIR / 'phone_state.db'\\n\\nconn = sqlite3.connect(DB)\\ncur = conn.cursor()\\ncur.executescript('''\\nCREATE TABLE IF NOT EXISTS snapshots (\\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\\n  captured_at TEXT,\\n  model TEXT,\\n  android TEXT,\\n  package_count INTEGER,\\n  source_file TEXT UNIQUE,\\n  imported_at TEXT\\n);\\nCREATE TABLE IF NOT EXISTS packages (\\n  snapshot_id INTEGER,\\n  package_name TEXT,\\n  apk_path TEXT,\\n  FOREIGN KEY(snapshot_id) REFERENCES snapshots(id)\\n);\\n''')\\nconn.commit()\\n\\nfor fp in sorted(INBOX.glob('*.json')):\\n  try:\\n    data = json.loads(fp.read_text())\\n    cur.execute(\\n      'INSERT OR IGNORE INTO snapshots(captured_at, model, android, package_count, source_file, imported_at) VALUES(?,?,?,?,?,?)',\\n      (\\n        data.get('captured_at'),\\n        data.get('device', {}).get('model'),\\n        data.get('device', {}).get('android'),\\n        data.get('package_count'),\\n        str(fp),\\n        datetime.utcnow().isoformat() + 'Z',\\n      )\\n    )\\n    conn.commit()\\n    cur.execute('SELECT id FROM snapshots WHERE source_file=?', (str(fp),))\\n    row = cur.fetchone()\\n    if not row:\\n      continue\\n    snapshot_id = row[0]\\n    cur.execute('DELETE FROM packages WHERE snapshot_id=?', (snapshot_id,))\\n    for pkg in data.get('packages', []):\\n      cur.execute(\\n        'INSERT INTO packages(snapshot_id, package_name, apk_path) VALUES(?,?,?)',\\n        (snapshot_id, pkg.get('package'), pkg.get('apk'))\\n      )\\n    conn.commit()\\n  except Exception as e:\\n    print(f'IMPORT_FAIL {fp}: {e}')\\n\\nprint(DB)\\n\",\"cross_profile\":false,\"path\":\"/var/home/charlie/phone-sync/scripts/import_phone_snapshots.py\"}"
