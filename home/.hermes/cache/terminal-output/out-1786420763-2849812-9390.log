red separately.",conditionValuePlaceholders:{string:"Text, for example APPROVED",number:"Number, for example 42",boolean:"true or false",null:"null",array:'JSON array, for example ["a", 2]',object:`JSON object, for example {'{'}"status":"ready"{'}'}`},invalidValueTypes:{string:"Value must be text.",number:"Value must be a valid number.",boolean:"Value must be true or false.",null:"Value must be null.",array:"Value must be a valid array.",object:"Value must be a valid object."},valueHelp:"Enter a value matching the selected type. Objects and arrays use JSON; strings are entered without JSON quotes.",expectedReplyText:"Text to find",expectedFieldValue:"Expected field value",rawTextValueHelp:"This checks the entire reply as literal text. With Contains, the text may appear in a JSON key or value; it does not look up a JSON field.",jsonFieldValueHelp:"This compares the value at the specified outputJson path, not the field name. Example: outputJson.failed_gate equals quality-container-setup.",canvasLabel:{withValue:"{subject} {operator} “{value}”",withoutValue:"{subject} {operator}",join:"{route} · {condition}"},conditionSemantics:"What is actually being compared",rawTextComparisonHelp:"The selected operator is {operator}. It applies to the complete reply text, not one JSON field. Contains or Does not contain can match text in either a JSON key or value. Equals requires the complete reply to equal the configured value; Does not equal requires the complete reply to differ.",jsonFieldComparisonHelp:"This reads the value at {path}. {operator} compares that field value with “{value}”; it never compares the field name.",rawTextExistenceHelp:"This checks whether the complete reply text is available; it does not check whether a JSON key exists.",jsonFieldExistenceHelp:"This checks whether the field at {path} exists; it does not compare the field value.",rawTextOperatorHelp:{equals:"Matches only when the complete reply text exactly equals “{value}”. It does not read or compare one JSON field value.",not_equals:"Matches only when the complete reply text is different from “{value}”. It does not read or compare one JSON field value.",contains:"Looks for “{value}” anywhere in the complete reply text. Text in either a JSON key or a JSON value can match; this is not a JSON field lookup.",not_contains:"Matches only when “{value}” does not appear anywhere in the complete reply text, whether in a JSON key or a JSON value. This is not a JSON field lookup.",exists:"Matches when the complete reply text is available. It does not check whether any JSON key exists.",not_exists:"Matches when no complete reply text is available. It does not check whether a JSON key is missing."},jsonFieldOperatorHelp:{equals:"Reads the value at {path}. Matches only when that field value exactly equals “{value}”; it never compares the field name.",not_equals:"Reads the value at {path}. Matches only when that field value is different from “{value}”; it never compares the field name.",contains:"Reads the value at {path} and checks whether that field value contains “{value}”; it never searches the field name.",not_contains:"Reads the value at {path}. Matches only when that field value does not contain “{value}”; it never searches the field name.",exists:"Matches when the JSON field at {path} exists. It does not compare the field value.",not_exists:"Matches when the JSON field at {path} is missing. It does not compare the field value."},feedback:"Feedback loop",feedbackHelp:"Marks this backward connection as a bounded loop. It repeats only while the route and condition match, and stops at Maximum iterations.",maxIterations:"Maximum iterations",maxIterationsHelp:"Total loop passes allowed, from 1 to 100. The run also has a global execution safety budget.",invalidIterations:"Maximum iterations must be an integer from 1 to 100",loopId:"Loop identity",loopIdPlaceholder:"Select automatic or type a custom ID",loopIdAutomatic:"Automatic (recommended) · {id}",loopIdHelp:"This only label