ater_than:"Ambos devem ser números JSON; o valor real é maior.",greater_than_or_equal:"Ambos devem ser números JSON; o valor real é maior ou igual.",less_than:"Ambos devem ser números JSON; o valor real é menor.",less_than_or_equal:"Ambos devem ser números JSON; o valor real é menor ou igual.",in:"Valor deve ser um array JSON que contenha o valor real.",not_in:"Valor deve ser um array JSON que não contenha o valor real."},value:"Valor",invalidConditionValue:"O valor da condição deve ser JSON válido",conditionValuePlaceholder:'JSON: "texto", 42, true, ["a"]',valueType:"Tipo do valor",valueTypes:{string:"Texto",number:"Número",boolean:"Booleano",null:"Nulo",array:"Array",object:"Objeto"},valueTypeHelp:"Escolha como o valor será interpretado e validado. O tipo é inferido do valor JSON salvo e não é armazenado separadamente.",conditionValuePlaceholders:{string:"Texto, por exemplo APPROVED",number:"Número, por exemplo 42",boolean:"true ou false",null:"null",array:'Array JSON, por exemplo ["a", 2]',object:`Objeto JSON, por exemplo {'{'}"status":"ready"{'}'}`},invalidValueTypes:{string:"O valor deve ser texto.",number:"O valor deve ser um número válido.",boolean:"O valor deve ser true ou false.",null:"O valor deve ser null.",array:"O valor deve ser um array válido.",object:"O valor deve ser um objeto válido."},valueHelp:"Insira um valor do tipo selecionado. Objetos e arrays usam JSON; textos são inseridos sem aspas JSON.",expectedReplyText:"Texto a localizar",expectedFieldValue:"Valor esperado do campo",rawTextValueHelp:"Isto verifica literalmente todo o texto da resposta. Com “Contém”, o texto pode aparecer numa chave ou num valor JSON; nenhum campo JSON é consultado.",jsonFieldValueHelp:"Isto compara o valor no caminho outputJson indicado, não o nome do campo. Exemplo: outputJson.failed_gate é igual a quality-container-setup.",canvasLabel:{withValue:"{subject} {operator} “{value}”",withoutValue:"{subject} {operator}",join:"{route} · {condition}"},conditionSemantics:"Regra realmente verificada",rawTextComparisonHelp:"O operador selecionado é {operator}. Aplica-se ao texto completo, não a um campo JSON. Contém/Não contém pode encontrar texto numa chave ou valor JSON; Igual/Diferente compara a resposta completa com o valor configurado.",jsonFieldComparisonHelp:"Lê o valor em {path}. {operator} compara esse value com “{value}”, nunca o nome do campo.",rawTextExistenceHelp:"Verifica apenas se o texto completo está disponível, não se existe uma chave JSON.",jsonFieldExistenceHelp:"Verifica apenas se o campo JSON em {path} existe; não compara o valor.",rawTextOperatorHelp:{equals:"Corresponde apenas quando o texto completo da resposta é exatamente igual a “{value}”. Não lê nem compara a value de um campo JSON.",not_equals:"Corresponde apenas quando o texto completo da resposta é diferente de “{value}”. Não lê nem compara a value de um campo JSON.",contains:"Procura “{value}” em todo o texto da resposta. O texto pode corresponder numa JSON key ou JSON value; isto não é uma pesquisa de campo JSON.",not_contains:"Corresponde apenas quando “{value}” não aparece em nenhuma parte do texto completo, nem numa JSON key nem numa JSON value. Isto não é uma pesquisa de campo JSON.",exists:"Corresponde quando o texto completo da resposta está disponível. Não verifica se existe uma JSON key.",not_exists:"Corresponde quando não há texto completo de resposta. Não verifica se falta uma JSON key."},jsonFieldOperatorHelp:{equals:"Lê a value do campo em {path}. Corresponde apenas quando esse valor é exatamente igual a “{value}”; nunca compara o nome do campo.",not_equals:"Lê a value do campo em {path}. Corresponde apenas quando esse valor é diferente de “{value}”; nunca compara o nome do campo.",contains:"Lê a value do campo em {path} e verifica se contém “{value}”; nunca pesquisa o nome do campo.",not_contains:"Lê a value do campo em {path}. Corresponde apenas quando não contém “{value}”; nunca pesquisa o nome do campo.",exists:"Corresponde quando o campo JSON em {path} existe. Não compara a value do campo.",not_exists:"Corresponde quando o campo JSON em {path} está ausente. Não compara a value do campo."},feedback:"Loop de feedback",feedbackHelp:"Marca esta conexão de retorno como loop limitado. Repete apenas enquanto rota e condição correspondem.",maxIterations:"Máximo de iterações",maxIterationsHelp:"Total de passagens do loop, de 1 a 100; o orçamento global também se aplica.",invalidIterations:"O máximo de iterações deve ser um inteiro entre 1 e 100",loopId:"Identidade do loop",loopIdPlaceholder:"Selecione automático ou digite um ID",loopIdAutomatic:"Automático (recomendado) · {id}",loopIdHelp:"Apenas identifica o loop no histórico e não muda quando ele executa. Mantenha automático salvo uso avançado.",invalidLoopId:"Formato de ID do loop inválido"},node:{title:"Nome do nó",agent:"Agente",model:"Modelo",apiMode:"Modo de API",input:"Entrada",approvalRequired:"Aprovação após o nó",join:"Estratégia de junção",joinAll:"Todas as rotas de entrada",joinAny:"Qualquer rota de entrada",joinAllHelp:"Executa apenas se todas as rotas de entrada forem tomadas; caso contrário, o nó é ignorado.",joinAnyHelp:"Executa uma vez na primeira rota tomada; só é ignorado quando nenhuma corresponde.",promptPlaceholder:"Descreva o que este agente deve fazer...",skillsPlaceholder:"Digite uma habilidade e pressione Enter para adicionar",uploadImages:"Enviar imagens"},status:{idle:"Inativo",queued:"Na fila",running:"Em execução",pending_approval:"Aguardando aprovação",completed:"Concluído",skipped:"Ignorado",failed:"Falhou",approval_rejected:"Aprovação rejeitada",canceled:"Cancelado"}},groupChat:{emptyState:"Inicie uma conversa em grupo",title:"Chat em grupo",refactorNoticeTitle:"Atualização do chat em grupo",refactorNoticeMessage:"O chat em grupo passou por uma grande reformulação. Se não for possível conversar em uma sala, crie uma nova.",createRoom:"Criar sala",joinByCode:"Entrar com código",roomName:"Nome da sala",roomNamePlaceholder:"Digite o nome da sala",inviteCode:"Código de convite",autoGenerate:"Gerar automaticamente",noRooms:"Ainda não há salas",selectOrCreate:"Selecione ou crie uma sala para começar a conversar",agents:"Agentes",addAgent:"Adicionar agente",agentType:"Agente",agentTypes:{hermes:"Hermes",ekko:"Ekko",codex:"Codex",claude:"Claude"},selectProfile:"Selecionar um Profile",agentAdded:"Agente adicionado",selectRoomFirst:"Selecione uma sala primeiro",agentAlreadyInRoom:"Este agente já está na sala",agentAddFailedCount:"{count} agente(s) não foram adicionados: {details}",editAgentTitle:"Editar {name}",deleteAgentConfirm:"Excluir {name}?",noAgents:"Não há agentes nesta sala",members:"{count} membros",roomCreated:"Sala criada",roomDeleted:"Sala excluída",roomCloned:"Sala clonada",cloneRoom:"Clonar sala",copyRoomLink:"Copiar link da sala",deleteRoomConfirm:"Excluir esta sala?",clearContext:"Limpar contexto",clearContextConfirm:"Limpar o contexto desta sala? As mensagens e os snapshots de compactação serão removidos, mas os agentes e membros permanecerão.",contextCleared:"Contexto limpo",you:"Você",joined:"Você entrou na sala",joinFailed:"Falha ao entrar na sala",inputPlaceholder:"Digite uma mensagem... (Enter para enviar)",messageDisplayLimit:"O chat em grupo exibe até 600 mensagens",enterCode:"Digite o código de convite",yourName:"Seu nome",yourNamePlaceholder:"Digite seu nome de exibição",yourDescription:"Descrição (opcional)",yourDescriptionPlaceholder:"Conte aos outros quem você é...",agentName:"Nome do agente",agentNamePlaceholder:"Nome personalizado (vazio para usar o nome do Profile)",agentDesc:"Descrição do agente",agentDescPlaceholder:"Descreva o que este agente faz...",agentReplying:"está respondendo...",agentCompressing:"está compactando o contexto...",compressionSettings:"Configurações de compactação",triggerTokens:"Tokens de acionamento",triggerTokensDesc:"Limite de tokens que aciona a compactação do contexto",maxHistoryTokens:"Máximo de tokens do histórico",maxHistoryTokensDesc:"Máximo de tokens do contexto compactado enviado ao LLM",tailMessageCount:"Mensagens recentes mantidas",tailMessageCountDesc:"Número de mensagens recentes mantidas integralmente após a compactação",compressionConfig:"Configuração de compactação",compressionSaved:"Configuração de compactação salva",roomSettings:"Configurações da sala",inviteCodeSettings:"Configurações do código de convite",inviteCodePlaceholder:"Insira um novo código de convite",generateInviteCode:"Gerar código de convite",inviteCodeRotateHint:"Atualizar inválida o código anterior para novas entradas.",inviteCodeUpdated:"Código de convite atualizado",inviteCodeUpdateFailed:"Falha ao atualizar o código de convite",saveCompression:"Salvar compressão",compressNow:"Compactar agora",compressingInProgress:"Compactação em andamento; aguarde",summarySettings:"Resumo contínuo",summarySettingsDesc:"Um Ekko Agent limpo atualiza o resumo compartilhado após um número fixo de turnos humanos.",summaryProvider:"Provider do resumo",summaryProviderPlaceholder:"Selecionar provider",summaryModel:"Modelo do resumo",summaryModelPlaceholder:"Selecionar modelo",summaryApiMode:"Modo da API",summaryEveryTurns:"Resumir a cada N turnos",summaryEveryTurnsDesc:"Um turno equivale a uma mensagem humana.",summaryConfigSaved:"Configuração do resumo salva",summaryConfigurationRequired:"Esta sala ainda não tem resumidor. Selecione perfil, provider, modelo e modo de API e salve.",summaryConfigurationOwnerRequired:"Esta sala ainda não tem resumidor. Peça a um administrador para configurá-lo antes de enviar mensagens.",saveSummaryConfig:"Salvar configuração",currentSummary:"Resumo atual",summaryStatus:{idle:"Pendente",summarizing:"Resumindo",success:"Concluído",failed:"Falhou"},summaryUpdatedAt:"Última atualização",summarizedTurns:"Turnos resumidos",summaryAnchor:"Âncora do resumo",summaryMessagesAbove:"Mensagens acima resumidas",summaryNoAnchor:"Ainda sem âncora",summaryContent:"Conteúdo do resumo",summaryEmpty:"Ainda não há resumo",summaryEditKeepsAnchor:"Editar o texto mantém a âncora atual.",saveSummary:"Salvar resumo",summaryUpdated:"Resumo atualizado",summaryNever:"Nunca",summaryLoadFailed:"Falha ao carregar o resumo da sala"},files:{attachToChat:"Adicionar ao chat",attachFailed:"Falha ao adicionar arquivo ao chat",previewMode:"Prévia",sourceMode:"Código-fonte",tableMode:"Tabela",worksheet:"Planilha",htmlPreviewTitle:"Prévia HTML isolada",previewLoading:"Carregando prévia...",previewFailed:"Prévia indisponível",previewMimeMismatch:"O tipo do arquivo não corresponde ao formato da prévia.",downloadInstead:"Baixar em vez disso",previousPage:"Anterior",nextPage:"Próxima",pageStatus:"Página {page} de {total}",zoom:"Zoom",pdfPageLimit:"Somente as primeiras {count} páginas são exibidas.",tableTruncated:"A prévia foi limitada. Baixe o arquivo para ver todas as linhas e colunas."},changelog:{new_0_6_39_1:"O Ekko Agent agora inicializa recursos explicitamente, executa código Node.js ou Python limitado mediante aprovação da ferramenta e pode pausar uma execução em primeiro plano para pedir esclarecimento em texto ou múltipla escolha antes de continuar (#2362, #2368)",new_0_6_39_2:"O Group Chat aguarda a confirmação de entrada na sala antes de enviar, corrigindo erros intermitentes “Not in room” durante reconexões. A digitação usa um heartbeat limitado e aparece apenas como uma luz pulsante sem texto nos avatares dos outros membros (#2373)",new_0_6_39_3:"Eventos de ferramentas do Coding Agent no Single Chat e Group Chat agora seguem o ciclo do CLI nativo e emitem um único início após os argumentos terminarem, removendo cartões duplicados ou presos e o atraso do JSON aparecendo caractere por caractere em salas grandes (#2366, #2372)",new_0_6_39_4:"Prompts do Coding Agent agora passam por stdin, preservando entradas multilinha e imagens e evitando o limite de comandos do Windows. O Group Chat também não interrompe trabalhos ativos do Codex, Claude Code ou Ekko após dois minutos fixos (#2354, #2357)",new_0_6_39_5:"O Codex usa o JSONL nativo e a saída do processo como estado final durante desconexões recuperáveis do proxy Provider, evitando que trabalhos concluídos sejam marcados como falha no Group Chat (#2375)",new_0_6_39_6:"O gerenciamento de versões valida a integridade do Runtime e mostra o motivo do fallback no desktop. Runtimes inválidos não podem ser ativados, e os controles de download ou troca do Web UI ficam ocultos porque as atualizações continuam pelo instalador desktop (#2353)",new_0_6_39_7:"Os cabeçalhos de execução do Group Chat agora mostram apenas o nome do Agent, removendo descrições repetidas para grupos de mensagens mais limpos (#2352)",new_0_6_39_8:"As conexões remotas do ESP32-C3 agora mantêm o Socket.IO ativo durante a descoberta, reutilizam buffers de voz limitados, reconectam com backoff e preservam o login em desconexões temporárias do Studio, tornando a busca remota e as interações de voz mais rápidas e confiáveis (#2383)",new_0_6_38_1:"Na inicialização, o desktop Windows corrige caminhos relativos inválidos do Python deixados por atualizações do Agent em ambientes Hermes Runtime armazenados, restaurando CLI, logs e Gateway após atualização, troca de Runtime ou migração de armazenamento",new_0_6_38_2:"O catálogo de compatibilidade do site volta a reconhecer o Hermes 0.19.0 para manter disponíveis os downloads de desktop e as verificações correspondentes (#2348)",new_0_6_37_1:"O destaque desta versão com 14 PRs é a reconstrução completa do Group Chat: cada Agent pode escolher de forma independente seu Profile, Provider, modelo, modo de API, nível de raciocínio, identidade e workspace (#2334)",new_0_6_37_2:"As salas agora iniciam execuções novas e isoladas e agrupam cada resposta com seu reasoning e ferramentas. Também incluem resumo contínuo compartilhado e editável com estado e limites, menções de Agent, drawers de sala/workspace e orientação de migração. A voz automática prepara antecipadamente o TTS de Profiles diferentes, limita a síntese a uma tarefa por Profile e reproduz em FIFO estrito, impedindo que novas respostas substituam o áudio em reprodução (#2334)",new_0_6_37_3:"O MiniMax Coding Plan OAuth oferece suporte às regiões Global e China, e as credenciais autorizadas de Codex, xAI, Anthropic, Nous e MiniMax são atualizadas pelo Runtime Bridge persistente (#2337)",new_0_6_37_4:"ESP32-C3 v1/v2 recebem escuta automática opcional com VAD local, áudio de pré-gravação, conclusão por silêncio e bloqueio durante reprodução, preservando o push-to-talk (#2338)",new_0_6_37_5:"O MCU Global Agent agora usa o modo de voz conciso do Ekko, pode delegar trabalho seguro em segundo plano, preserva histórico e workspaces e não envia resultados de ferramentas grandes demais ao dispositivo (#2326)",new_0_6_37_6:"TTS personalizados e compatíveis com OpenAI repetem automaticamente formatos de áudio aceitos pelo Provider e convertem saídas não MP3 para reprodução no Hermes (#2328)",new_0_6_37_7:"Importação e exportação de Profiles têm até dez minutos, exibem erros de timeout claros, isolam arquivos simultâneos, higienizam nomes e removem arquivos temporários (#2310, #2324)",new_0_6_37_8:"O Hermes Agent Bridge aplica padrões de raciocínio específicos por modelo, preservando substituições explícitas por execução e o fallback anterior (#2325)",new_0_6_37_9:"O gerenciamento de versões mostra separadamente a versão real instalada do Hermes Agent e o caminho Runtime, esclarecendo o escopo da atualização CLI e a necessidade de fechar o Studio completamente (#2323)",new_0_6_37_10:"As árvores de arquivos workspace usam recuo menor para manter visíveis nomes profundamente aninhados (#2340)",new_0_6_37_11:"O desktop agora usa Hermes Agent 0.20.0 por padrão a partir de fonte fixada, fixa Node/npm portáteis, aceita launchers regenerados no Windows, atualiza sem Python do sistema e mantém o Gateway gerenciado oculto (#2321, #2344)",new_0_6_37_12:"A migração do armazenamento Runtime no Windows processa links criados por atualizações sem privilégios de administrador, reajusta Python, aceita caminhos Unicode e atualiza shims CLI/MCP na primeira reinicialização (#2345)",new_0_6_37_13:"A assinatura desktop do macOS usa um keychain temporário explícito compatível com o modo estrito dos runners macOS 26 nas duas arquiteturas (#2315)",new_0_6_36_1:"Esta versão reúne todos os 28 PRs mesclados após a 0.6.35, abrangendo voz, árabe e RTL, App Relay, confiabilidade dos agentes, experiência de chat, Kanban, Journey, legendas MCU e logs de solicitações do Ekko",new_0_6_36_2:"As configurações de voz foram unificadas em Modelos para provedores nativos do Hermes e da Web UI; Custom TTS permite escolher a voz e Edge TTS aceita qualquer Voice ID com opções em árabe (#2260, #2265, #2267)",new_0_6_36_3:"O suporte completo a árabe e RTL agora abrange fluxo do documento, Naive UI, chat, chat em grupo, Workflow, sobreposições, gavetas, direção por bloco e termos de Profile corrigidos (#2269, #2270, #2271, #2273, #2277, #2294, #2303)",new_0_6_36_4:"Delegações ativas em segundo plano mantêm a sessão do Agent Bridge viva até o fim, impedindo que a limpeza por inatividade interrompa tarefas longas (#2254)",new_0_6_36_5:"A lista de agentes do chat em grupo voltou a aceitar cliques no desktop, e a janela principal pode ser reduzida a 769 px sem entrar no layout móvel (#2259, #2263)",new_0_6_36_6:"Os workspace diffs do Codex, Claude Code e Ekko aparecem somente na mensagem exata do assistente que os produziu em chats ativos, restaurados e em grupo (#2264)",new_0_6_36_7:"Os READMEs em inglês e chinês agora refletem o produto e a CLI atuais, enquanto o manual obsoleto do site vinculado à versão 0.6.12 foi removido (#2268)",new_0_6_36_8:"Um App Relay independente e sem interface adiciona pareamento seguro e acesso remoto autenticado a APIs locais permitidas e ao streaming do chat sem expor o Studio diretamente (#2275)",new_0_6_36_9:"O Desktop Agent Browser pode ler com segurança textos acessíveis longos em páginas e ativar controles cuja referência do snapshot aponta para texto visível (#2278)",new_0_6_36_10:"O chat ganha controles de Provider fixos, restauração da rolagem por mensagem, trilhos compactos de ferramentas e terminal, visualizações completas e workspace diffs em largura total (#2279, #2282, #2283, #2293)",new_0_6_36_11:"Novas sessões do Ekko recebem workspaces padrão isolados por Profile, enquanto workspaces existentes e escolhidos explicitamente permanecem inalterados (#2289)",new_0_6_36_12:"Os resultados de aprovação de Memory e Skill agora são estruturados e serializados, evitando falsos sucessos e gravações simultâneas no mesmo Profile (#2295)",new_0_6_36_13:"Kanban adiciona arquivamento confiável de tarefas e um quadro panorâmico, enquanto Journey se torna um mapa compacto e determinístico de relações entre Memory e Skill (#2296, #2297)",new_0_6_36_14:"O reasoning ao vivo permanece estável entre ferramentas, é restaurado na mensagem ou ferramenta correta e não cria mais bolhas vazias de subagentes (#2299)",new_0_6_36_15:"A fala do MCU agora exibe legendas GB2312 sincronizadas e paginadas no ESP32-C3 v1 e v2 sem interromper a reprodução de áudio (#2305)",new_0_6_36_16:"O Ekko agora grava um log compacto model.request por tentativa de modelo, incluindo compressão de contexto, e omite tool_choice quando não há ferramentas (#2311)",new_0_6_35_1:"A memória persistente do Ekko Agent agora está habilitada em produção, com armazenamento SQLite isolado por perfil, orçamento de recuperação automática de 4.000 tokens, busca de relevância aprimorada em toda a memória e tratamento mais seguro das solicitações ao modelo (#2246)",new_0_6_34_1:"Esta versão inclui todos os 21 PRs mesclados após a 0.6.33, abrangendo temas por usuário, melhorias no Ekko e nos Coding Agents, desktop e navegador, automação e confiabilidade",new_0_6_34_2:"Cada conta pode personalizar tamanho e cor do texto, cor de destaque e fundo do workspace com superfícies translúcidas consistentes; janelas do Windows e configurações do navegador seguem o tema, e os comandos de navegador do Ekko iniciam corretamente no Windows (#2242, #2243, #2244)",new_0_6_34_3:"O Ekko está disponível em produção com descoberta de Skills sob demanda e entrada multimodal; evolução protegida de Skills, logs isolados por Profile, persistência de protocolo e resumos de raciocínio do Responses aumentam sua segurança e capacidade (#2215, #2236)",new_0_6_34_4:"A memória do Ekko adiciona categorias estruturadas e determinísticas para preferências, relacionamentos, hábitos, metas de longo prazo e mais; conversas longas agora usam o ciclo compartilhado de compressão de contexto baseado em snapshots (#2229, #2230)",new_0_6_34_5:"Execuções de Coding Agent preservam imagens entre Codex, Claude Code e protocolos Provider com escopo, truncam saídas de ferramentas grandes demais no Responses e isolam por sessão a configuração de execução e eventos atrasados (#2222, #2232, #2238)",new_0_6_34_6:"A verificação de capacidades do Hermes Workflow não rejeita mais destinos válidos sem metadados de modo de API; o Kanban acompanha as tarefas e prévias de anexos do Hermes Agent 0.19, e o Executar agora do Cron inicia com segurança em segundo plano e validação de criação mais rigorosa (#2239, #2216, #2228)",new_0_6_34_7:"O desktop adiciona janelas de chat independentes e focadas, permite automação em campos de senha, pagamento e arquivo no navegador e preserva separadamente o nome e a descrição de cada membro humano em cada sala de Group Chat (#2209, #2210, #2212)",new_0_6_34_8:"O comando /yolo por sessão alterna a dispensa de aprovação, o limite visual de 200 turnos do Agent foi removido, o Markdown preserva aspas ASCII retas e o catálogo pt-BR recupera os sinais diacríticos ausentes (#2223, #2225, #2234, #2221)",new_0_6_34_9:"Dispositivos ESP32-C3 recebem espera conectada configurável que reduz o consumo ocioso mantendo Wi-Fi, login, Profile e Socket.IO, com despertar imediato e tempo limite persistente (#2218)",new_0_6_33_1:"Esta versão inclui todos os 16 PRs mesclados após a 0.6.32, abrangendo Agent Browser no desktop, evidências e prazos de execução do Workflow, interações com arquivos e chats, atualização de modelos Provider e confiabilidade",new_0_6_33_2:"O desktop recebe um Agent Browser visível com várias abas, Profiles isolados, controles de proxy, armazenamento e downloads, cookies persistentes criptografados, ações de Agent protegidas e descoberta tardia de ferramentas MCP (#2177, #2182)",new_0_6_33_3:"Links de chats individuais e em grupo e prévias HTML autenticadas abrem no navegador integrado; também foram refinados o espaçamento das permissões, os ícones de navegação multiplataforma e a integração entre barra lateral e barra de título no Windows (#2191, #2194, #2198)",new_0_6_33_4:"Execuções de Workflow preservam a visualização imutável do início, exibem um prazo total de Run/Rerun com tempo decorrido e restante e apresentam histórico e detalhes em páginas baseadas no caminho realmente consumido (#2171, #2173, #2180)",new_0_6_33_5:"Arquivos podem ser colados diretamente em chats individuais ou em grupo, ou anexados pelo menu de contexto do workspace; colunas compactas de metadados deixam mais espaço para os nomes (#2175, #2176)",new_0_6_33_6:"Cada Provider configurado pode atualizar seu catálogo separadamente, confirmar remoções, preservar modelos padrão indisponíveis e restaurar uma vez; Provider OAuth, localização completa e comportamento de preenchimento automático dos formulários estão incluídos (#2115)",new_0_6_33_7:"Os estados de interrupção e pausa são isolados por sessão para que conversas em segundo plano não alterem o botão de parada ativo; seleções de texto e campos do desktop também recebem ações nativas de clique direito (#2203, #2204)",new_0_6_33_8:"Saída, atualização e instalação no desktop usam encerramento gradual com limite e só forçam as árvores de processos restantes do Agent Bridge, MCP, navegador e Web UI após o prazo de limpeza (#2193)",new_0_6_33_9:"Sessões de voz MCU isolam resultados em primeiro e segundo plano, enquanto nomes de ferramentas MCP compatíveis com MiniMax respeitam o limite do Provider sem quebrar clientes existentes (#2181, #2169)",new_0_6_32_1:"Esta versão inclui todos os 14 PRs mesclados após a 0.6.31, abrangendo organização e compactação de sessões, chat em grupo, roteamento de Workflow, Skill Bundles, memória Ekko, Hermes 0.19 e moldura do desktop",new_0_6_32_2:"As menções no chat em grupo agora funcionam após texto CJK, emojis e pontuação; proprietários podem ver, gerar e trocar códigos de convite nas configurações da sala (#2133, #2141)",new_0_6_32_3:"O Workflow preserva a origem de cada execução do Hermes Bridge em transferências e reconexões; nós Codex e Claude Code com escopo podem usar protocolos aceitos pelo launcher para destinos válidos com API Key (#2137, #2154)",new_0_6_32_4:"As sessões ganham categorias globais, busca mais precisa com reconhecimento de Markdown e compactação por cursor que limita o histórico e mantém a correção em edições, ramificações e execuções simultâneas; o projeto de compactação foi documentado por completo (#2139, #2143, #2145, #2146)",new_0_6_32_5:"Skill Bundles do Profile podem ser criados, explorados, executados e excluídos diretamente no chat, mostrando claramente os Skills incluídos (#2156)",new_0_6_32_6:"A memória Ekko agora usa um único modelo canônico isolado por Profile, com alterações validadas por revisão, auditoria de origem reforçada e filtragem de relevância mais rigorosa (#2159)",new_0_6_32_7:"Mensagens intermediárias do assistente no Hermes 0.19 são transmitidas e salvas em balões separados; chats individuais comuns podem receber de forma assíncrona resultados persistentes de delegações em segundo plano (#2160)",new_0_6_32_8:"Novos builds do Runtime para desktop, caminhos alternativos e shims de CLI do Windows agora usam Hermes Agent 0.19.0 por padrão (#2161)",new_0_6_32_9:"Os controles de janela foram integrados à moldura da página: os semáforos do macOS ficam na barra lateral, os controles do Windows acima do conteúdo principal e o Linux mantém as decorações nativas (#2162)",new_0_6_32_10:"A documentação de desenvolvimento agora aceita tanto o checkout atual quanto worktrees Git isoladas opcionais (#2155)"}};export{e as default};
