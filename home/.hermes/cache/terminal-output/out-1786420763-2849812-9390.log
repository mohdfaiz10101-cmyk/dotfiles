ere del valor JSON guardado y no se almacena por separado.",conditionValuePlaceholders:{string:"Texto, por ejemplo APPROVED",number:"Número, por ejemplo 42",boolean:"true o false",null:"null",array:'Array JSON, por ejemplo ["a", 2]',object:`Objeto JSON, por ejemplo {'{'}"status":"ready"{'}'}`},invalidValueTypes:{string:"El valor debe ser texto.",number:"El valor debe ser un número válido.",boolean:"El valor debe ser true o false.",null:"El valor debe ser null.",array:"El valor debe ser un array válido.",object:"El valor debe ser un objeto válido."},valueHelp:"Introduce un valor del tipo seleccionado. Los objetos y arrays usan JSON; las cadenas se escriben sin comillas JSON.",expectedReplyText:"Texto que buscar",expectedFieldValue:"Valor esperado del campo",rawTextValueHelp:"Se comprueba literalmente todo el texto de la respuesta. Con “Contiene”, el texto puede aparecer en una clave o un valor JSON; no se consulta un campo JSON concreto.",jsonFieldValueHelp:"Se compara el valor de la ruta outputJson indicada, no el nombre del campo. Ejemplo: outputJson.failed_gate es igual a quality-container-setup.",canvasLabel:{withValue:"{subject} {operator} «{value}»",withoutValue:"{subject} {operator}",join:"{route} · {condition}"},conditionSemantics:"Regla que se comprueba realmente",rawTextComparisonHelp:"El operador seleccionado es {operator}. Se aplica al texto completo, no a un campo JSON. Contiene/No contiene puede encontrar texto en una clave o valor JSON; Igual/Distinto compara la respuesta completa con el valor configurado.",jsonFieldComparisonHelp:"Lee el valor de {path}. {operator} compara ese value con «{value}» y nunca el nombre del campo.",rawTextExistenceHelp:"Solo comprueba que esté disponible el texto completo, no que exista una clave JSON.",jsonFieldExistenceHelp:"Solo comprueba si existe el campo JSON de {path}; no compara su valor.",rawTextOperatorHelp:{equals:"Coincide solo si el texto completo de la respuesta es exactamente igual a «{value}». No lee ni compara la value de un campo JSON.",not_equals:"Coincide solo si el texto completo de la respuesta es distinto de «{value}». No lee ni compara la value de un campo JSON.",contains:"Busca «{value}» en todo el texto de la respuesta. Puede coincidir en una JSON key o una JSON value; no es una búsqueda de campo JSON.",not_contains:"Coincide solo si «{value}» no aparece en ninguna parte del texto completo, ni en una JSON key ni en una JSON value. No es una búsqueda de campo JSON.",exists:"Coincide cuando está disponible el texto completo de la respuesta. No comprueba si existe una JSON key.",not_exists:"Coincide cuando no hay texto completo de respuesta. No comprueba si falta una JSON key."},jsonFieldOperatorHelp:{equals:"Lee la value del campo en {path}. Coincide solo si ese valor es exactamente igual a «{value}»; nunca compara el nombre del campo.",not_equals:"Lee la value del campo en {path}. Coincide solo si ese valor es distinto de «{value}»; nunca compara el nombre del campo.",contains:"Lee la value del campo en {path} y comprueba si contiene «{value}»; nunca busca en el nombre del campo.",not_contains:"Lee la value del campo en {path}. Coincide solo si no contiene «{value}»; nunca busca en el nombre del campo.",exists:"Coincide cuando existe el campo JSON en {path}. No compara la value del campo.",not_exists:"Coincide cuando falta el campo JSON en {path}. No compara la value del campo."},feedback:"Bucle de retroalimentación",feedbackHelp:"Marca esta conexión de retorno como un bucle limitado. Solo repite mientras coincidan ruta y condición.",maxIterations:"Iteraciones máximas",maxIterationsHelp:"Total de pasadas del bucle, de 1 a 100; también se aplica el presupuesto global.",invalidIterations:"Las iteraciones máximas deben ser un entero entre 1 y 100",loopId:"Identidad del bucle",loopIdPlaceholder:"Selecciona automático o escribe un ID",loopIdAutomatic:"Automático (recomendado) · {id}",loopIdHelp:"Solo identifica el bucle en el historial; no cambia cuándo se ejecuta. Déjalo automático salvo diseños avanzados.",invalidLoopId:"El formato del ID del bucle no es válido"},node:{title:"Nombre del nodo",agent:"Agente",model:"Modelo",apiMode:"Modo de API",input:"Entrada",approvalRequired:"Aprobación tras el nodo",join:"Estrategia de unión",joinAll:"Todas las rutas entrantes",joinAny:"Cualquier ruta entrante",joinAllHelp:"Se ejecuta solo si se toman todas las rutas entrantes; si alguna no coincide, se omite.",joinAnyHelp:"Se ejecuta una vez con la primera ruta tomada; se omite solo si ninguna coincide.",promptPlaceholder:"Describe qué debe hacer este agente...",skillsPlaceholder:"Escribe una habilidad y pulsa Entrar para añadirla",uploadImages:"Subir imágenes"},status:{idle:"Inactivo",queued:"En cola",running:"En ejecución",pending_approval:"Pendiente de aprobación",completed:"Completado",skipped:"Omitido",failed:"Fallido",approval_rejected:"Aprobación rechazada",canceled:"Cancelado"}},groupChat:{emptyState:"Inicia una conversación grupal",title:"Chat grupal",refactorNoticeTitle:"Actualización del chat grupal",refactorNoticeMessage:"El chat grupal se ha rediseñado por completo. Si no puedes chatear en una sala, crea una nueva.",createRoom:"Crear sala",joinByCode:"Unirse con código",roomName:"Nombre de la sala",roomNamePlaceholder:"Introduce el nombre de la sala",inviteCode:"Código de invitación",autoGenerate:"Generar automáticamente",noRooms:"Aún no hay salas",selectOrCreate:"Selecciona o crea una sala para empezar a chatear",agents:"Agentes",addAgent:"Añadir agente",agentType:"Agente",agentTypes:{hermes:"Hermes",ekko:"Ekko",codex:"Codex",claude:"Claude"},selectProfile:"Seleccionar un Profile",agentAdded:"Agente añadido",selectRoomFirst:"Selecciona primero una sala",agentAlreadyInRoom:"Este agente ya está en la sala",agentAddFailedCount:"No se añadieron {count} agente(s): {details}",editAgentTitle:"Editar {name}",deleteAgentConfirm:"¿Eliminar a {name}?",noAgents:"No hay agentes en esta sala",members:"{count} miembros",roomCreated:"Sala creada",roomDeleted:"Sala eliminada",roomCloned:"Sala clonada",cloneRoom:"Clonar sala",copyRoomLink:"Copiar enlace de la sala",deleteRoomConfirm:"¿Eliminar esta sala?",clearContext:"Borrar contexto",clearContextConfirm:"¿Borrar el contexto de esta sala? Se eliminarán los mensajes y las instantáneas de compresión, pero se conservarán los agentes y los miembros.",contextCleared:"Contexto borrado",you:"Tú",joined:"Te has unido a la sala",joinFailed:"No se pudo entrar en la sala",inputPlaceholder:"Escribe un mensaje... (Intro para enviar)",messageDisplayLimit:"El chat grupal muestra hasta 600 mensajes",enterCode:"Introduce el código de invitación",yourName:"Tu nombre",yourNamePlaceholder:"Introduce tu nombre visible",yourDescription:"Descripción (opcional)",yourDescriptionPlaceholder:"Cuéntales a los demás quién eres...",agentName:"Nombre del agente",agentNamePlaceholder:"Nombre personalizado (vacío para usar el nombre del Profile)",agentDesc:"Descripción del agente",agentDescPlaceholder:"Describe qué hace este agente...",agentReplying:"está respondiendo...",agentCompressing:"está comprimiendo el contexto...",compressionSettings:"Ajustes de compresión",triggerTokens:"Tokens de activación",triggerTokensDesc:"Umbral de tokens que activa la compresión del contexto",maxHistoryTokens:"Tokens máximos del historial",maxHistoryTokensDesc:"Máximo de tokens del contexto comprimido enviado al LLM",tailMessageCount:"Mensajes recientes conservados",tailMessageCountDesc:"Número de mensajes recientes que se conservan sin cambios tras la compresión",compressionConfig:"Configuración de compresión",compressionSaved:"Configuración de compresión guardada",roomSettings:"Configuración de sala",inviteCodeSettings:"Configuración del código de invitación",inviteCodePlaceholder:"Introduce un nuevo código de invitación",generateInviteCode:"Generar código de invitación",inviteCodeRotateHint:"Al actualizarlo, el código anterior deja de servir para nuevas uniones.",inviteCodeUpdated:"Código de invitación actualizado",inviteCodeUpdateFailed:"No se pudo actualizar el código de invitación",saveCompression:"Guardar compresión",compressNow:"Comprimir ahora",compressingInProgress:"Compresión en curso; espera un momento",summarySettings:"Resumen continuo",summarySettingsDesc:"Un Ekko Agent limpio actualiza el resumen compartido tras un número fijo de turnos humanos.",summaryProvider:"Proveedor del resumen",summaryProviderPlaceholder:"Seleccionar proveedor",summaryModel:"Modelo del resumen",summaryModelPlaceholder:"Seleccionar modelo",summaryApiMode:"Modo de API",summaryEveryTurns:"Resumir cada N turnos",summaryEveryTurnsDesc:"Un turno equivale a un mensaje humano.",summaryConfigSaved:"Configuración del resumen guardada",summaryConfigurationRequired:"Esta sala aún no tiene resumidor. Selecciona perfil, proveedor, modelo y modo de API, y guarda.",summaryConfigurationOwnerRequired:"Esta sala aún no tiene resumidor. Pide a un administrador que lo configure antes de enviar mensajes.",saveSummaryConfig:"Guardar configuración",currentSummary:"Resumen actual",summaryStatus:{idle:"Pendiente",summarizing:"Resumiendo",success:"Correcto",failed:"Falló"},summaryUpdatedAt:"Última actualización",summarizedTurns:"Turnos resumidos",summaryAnchor:"Ancla del resumen",summaryMessagesAbove:"Mensajes anteriores resumidos",summaryNoAnchor:"Aún no hay ancla",summaryContent:"Contenido del resumen",summaryEmpty:"Aún no hay resumen",summaryEditKeepsAnchor:"Editar el texto no mueve el ancla actual.",saveSummary:"Guardar resumen",summaryUpdated:"Resumen actualizado",summaryNever:"Nunca",summaryLoadFailed:"No se pudo cargar el resumen de la sala"},files:{attachToChat:"Añadir al chat",attachFailed:"No se pudo añadir el archivo al chat",previewMode:"Vista previa",sourceMode:"Código fuente",tableMode:"Tabla",worksheet:"Hoja",htmlPreviewTitle:"Vista previa HTML aislada",previewLoading:"Cargando vista previa...",previewFailed:"Vista previa no disponible",previewMimeMismatch:"El tipo de archivo no coincide con el formato de vista previa.",downloadInstead:"Descargar en su lugar",previousPage:"Anterior",nextPage:"Siguiente",pageStatus:"Página {page} de {total}",zoom:"Zoom",pdfPageLimit:"Solo se muestran las primeras {count} páginas.",tableTruncated:"La vista previa se ha limitado. Descarga el archivo para ver todas las filas y columnas."},changelog:{new_0_6_39_1:"Ekko Agent ahora inicializa sus recursos de forma explícita, ejecuta código Node.js o Python limitado tras la aprobación de la herramienta y puede pausar una ejecución en primer plano para pedir aclaraciones de texto o de opción múltiple antes de continuar (#2362, #2368)",new_0_6_39_2:"Group Chat espera la confirmación de entrada a la sala antes de enviar, corrigiendo errores intermitentes «Not in room» al reconectar. La escritura se envía como heartbeat limitado y solo aparece como una luz de respiración sin texto en los avatares de otros miembros (#2373)",new_0_6_39_3:"Los eventos de herramientas de Coding Agent en Single Chat y Group Chat siguen ahora el ciclo del CLI nativo y emiten un único inicio cuando terminan los argumentos, eliminando tarjetas duplicadas o bloqueadas y el JSON mostrado carácter a carácter en salas grandes (#2366, #2372)",new_0_6_39_4:"Los prompts de Coding Agent se envían por stdin, conservando entradas multilínea e imágenes y evitando el límite de comandos de Windows. Group Chat tampoco interrumpe trabajos activos de Codex, Claude Code o Ekko tras dos minutos fijos (#2354, #2357)",new_0_6_39_5:"Codex usa el JSONL nativo y la salida del proceso como estado final durante desconexiones recuperables del proxy Provider, evitando que un trabajo terminado aparezca como fallo en Group Chat (#2375)",new_0_6_39_6:"Gestión de versiones valida que el Runtime esté completo y muestra el motivo del fallback de escritorio. Los Runtime inválidos no pueden activarse y se ocultan los controles de descarga o cambio del Web UI porque las actualizaciones siguen llegando con el instalador de escritorio (#2353)",new_0_6_39_7:"Los encabezados de ejecución de Group Chat muestran solo el nombre del Agent y eliminan descripciones repetidas para agrupar los mensajes con mayor claridad (#2352)",new_0_6_39_8:"Las conexiones remotas del ESP32-C3 mantienen Socket.IO activo durante la búsqueda, reutilizan búferes de voz limitados, se reconectan con espera progresiva y conservan la sesión ante desconexiones temporales de Studio, haciendo más rápidas y fiables la búsqueda remota y las interacciones de voz (#2383)",new_0_6_38_1:"Al iniciar, el escritorio de Windows repara las rutas relativas de Python no válidas que las actualizaciones del Agent dejan en entornos Hermes Runtime almacenados, y restaura CLI, registros y Gateway tras actualizar, cambiar de Runtime o migrar el almacenamiento",new_0_6_38_2:"El catálogo de compatibilidad del sitio web vuelve a reconocer Hermes 0.19.0 para mantener disponibles las descargas de escritorio y las comprobaciones correspondientes (#2348)",new_0_6_37_1:"La prioridad de esta versión con 14 PR es la reconstrucción completa de Group Chat: cada Agent puede elegir de forma independiente su Profile, Provider, modelo, modo API, nivel de razonamiento, identidad y workspace (#2334)",new_0_6_37_2:"Las salas ahora inician ejecuciones nuevas y aisladas y agrupan cada respuesta con su reasoning y herramientas. También incorporan un resumen progresivo compartido y editable con estado y límites, menciones de Agent, paneles de sala/workspace y guía de migración. La voz automática prepara por adelantado el TTS de distintos Profile, limita la síntesis a una tarea por Profile y reproduce en FIFO estricto, por lo que una respuesta nueva no sustituye el audio en curso (#2334)",new_0_6_37_3:"MiniMax Coding Plan OAuth admite las regiones Global y China, y las credenciales autorizadas de Codex, xAI, Anthropic, Nous y MiniMax se actualizan mediante el Runtime Bridge persistente (#2337)",new_0_6_37_4:"ESP32-C3 v1/v2 añaden escucha automática opcional con VAD local, audio previo, finalización por silencio y supresión durante la reproducción, conservando el control push-to-talk (#2338)",new_0_6_37_5:"MCU Global Agent usa ahora el modo de voz conciso de Ekko, puede delegar trabajo seguro en segundo plano, conserva historial y workspaces y deja de enviar resultados de herramientas demasiado grandes al dispositivo (#2326)",new_0_6_37_6:"Los TTS personalizados y compatibles con OpenAI reintentan automáticamente formatos de audio admitidos por el Provider y convierten salidas no MP3 para reproducirlas en Hermes (#2328)",new_0_6_37_7:"La importación y exportación de Profiles dispone de hasta diez minutos, muestra errores de tiempo claros, aísla archivos simultáneos, sanea nombres y elimina archivos temporales (#2310, #2324)",new_0_6_37_8:"Hermes Agent Bridge aplica valores de razonamiento específicos por modelo y conserva las anulaciones explícitas por ejecución y el fallback anterior (#2325)",new_0_6_37_9:"Gestión de versiones muestra por separado la versión real de Hermes Agent instalada y la ruta Runtime, y aclara el alcance de la actualización CLI y la necesidad de cerrar Studio por completo (#2323)",new_0_6_37_10:"Los árboles de archivos workspace usan una sangría menor para mantener visibles los nombres muy anidados (#2340)",new_0_6_37_11:"El escritorio usa por defecto Hermes Agent 0.20.0 desde código fijado, fija Node/npm portátiles, acepta launchers regenerados en Windows, actualiza sin Python del sistema y mantiene oculto el Gateway administrado (#2321, #2344)",new_0_6_37_12:"La migración de almacenamiento Runtime en Windows procesa enlaces creados por actualizaciones sin permisos de administrador, reajusta Python, admite rutas Unicode y actualiza los shims CLI/MCP en el primer reinicio (#2345)",new_0_6_37_13:"La firma de escritorio para macOS usa un keychain temporal explícito compatible con el modo estricto de los runners macOS 26 en ambas arquitecturas (#2315)",new_0_6_36_1:"Esta versión incluye los 28 PR fusionados después de 0.6.35, con mejoras de voz, árabe y RTL, App Relay, fiabilidad de agentes, experiencia de chat, Kanban, Journey, subtítulos MCU y registros de solicitudes de Ekko",new_0_6_36_2:"La configuración de voz se unifica en Modelos para proveedores nativos de Hermes y de la Web UI; Custom TTS permite elegir voz y Edge TTS acepta cualquier Voice ID con opciones en árabe (#2260, #2265, #2267)",new_0_6_36_3:"El árabe y la compatibilidad RTL integral abarcan ahora el flujo del documento, Naive UI, chat, chat grupal, Workflow, capas, cajones, dirección por bloque y términos de Profile corregidos (#2269, #2270, #2271, #2273, #2277, #2294, #2303)",new_0_6_36_4:"Las delegaciones activas en segundo plano mantienen viva su sesión de Agent Bridge hasta finalizar, evitando que la limpieza por inactividad interrumpa tareas largas (#2254)",new_0_6_36_5:"La lista de agentes del chat grupal vuelve a responder a clics en escritorio y la ventana principal puede reducirse hasta 769 px sin entrar en el diseño móvil (#2259, #2263)",new_0_6_36_6:"Los workspace diffs de Codex, Claude Code y Ekko aparecen únicamente en el mensaje exacto del asistente que los generó, tanto en chats activos como restaurados y grupales (#2264)",new_0_6_36_7:"Los README en inglés y chino reflejan ahora el producto y la CLI actuales, y se eliminó del sitio web el manual obsoleto ligado a la versión 0.6.12 (#2268)",new_0_6_36_8:"Un App Relay independiente y sin interfaz añade emparejamiento seguro y acceso remoto autenticado a APIs locales permitidas y al streaming del chat sin exponer Studio directamente (#2275)",new_0_6_36_9:"Desktop Agent Browser puede leer de forma segura textos accesibles largos por páginas y activar controles cuya referencia del snapshot corresponde a texto visible (#2278)",new_0_6_36_10:"El chat incorpora controles de Provider anclados, restauración del desplazamiento por mensaje, barras compactas de herramientas y terminal, vistas previas completas y workspace diffs a todo lo ancho (#2279, #2282, #2283, #2293)",new_0_6_36_11:"Las nuevas sesiones de Ekko reciben workspaces predeterminados aislados por Profile, mientras que los existentes y los elegidos explícitamente no cambian (#2289)",new_0_6_36_12:"Los resultados de aprobación de Memory y Skill son ahora estructurados y serializados, evitando falsos mensajes de éxito y escrituras simultáneas en el mismo Profile (#2295)",new_0_6_36_13:"Kanban añade archivado fiable de tareas y un tablero desplazable, mientras Journey se convierte en un mapa compacto y determinista de relaciones entre Memory y Skill (#2296, #2297)",new_0_6_36_14:"El reasoning en vivo permanece estable entre herramientas, se restaura en el mensaje o herramienta correctos y deja de crear burbujas vacías de subagentes (#2299)",new_0_6_36_15:"La voz del MCU muestra ahora subtítulos GB2312 sincronizados y paginados en ESP32-C3 v1 y v2 sin interrumpir la reproducción de audio (#2305)",new_0_6_36_16:"Ekko escribe ahora un registro compacto model.request por intento de modelo, incluida la compresión de contexto, y omite tool_choice cuando no hay herramientas (#2311)",new_0_6_35_1:"La memoria persistente de Ekko Agent ya está habilitada en producción, con almacenamiento SQLite aislado por perfil, un presupuesto de recuperación automática de 4.000 tokens, una búsqueda de relevancia mejorada en toda la memoria y un manejo más seguro de las solicitudes al modelo (#2246)",new_0_6_34_1:"Esta versión incluye los 21 PR fusionados después de 0.6.33: temas por usuario, mejoras de Ekko y Coding Agent, escritorio y navegador, automatización y correcciones de fiabilidad",new_0_6_34_2:"Cada cuenta puede personalizar el tamaño y color del texto, el color de acento y el fondo del workspace con superficies translúcidas coherentes; las ventanas de Windows y los ajustes del navegador siguen el tema, y los comandos del navegador de Ekko ya se inician correctamente en Windows (#2242, #2243, #2244)",new_0_6_34_3:"Ekko está disponible en producción con descubrimiento de Skill bajo demanda y entrada multimodal; la evolución protegida de Skills, los logs aislados por Profile, la persistencia del protocolo y los resúmenes de razonamiento de Responses mejoran su seguridad y capacidad (#2215, #2236)",new_0_6_34_4:"La memoria de Ekko incorpora clases estructuradas y deterministas para preferencias, relaciones, hábitos, objetivos a largo plazo y más; las conversaciones largas usan ahora el ciclo compartido de compresión de contexto basado en snapshots (#2229, #2230)",new_0_6_34_5:"Las ejecuciones de Coding Agent conservan imágenes entre Codex, Claude Code y protocolos Provider con alcance, recortan salidas de herramientas demasiado grandes en Responses y aíslan por sesión la configuración de ejecución y los eventos tardíos (#2222, #2232, #2238)",new_0_6_34_6:"La comprobación de capacidades de Hermes Workflow ya no rechaza destinos válidos sin metadatos de modo API; Kanban se adapta a las tareas y vistas de adjuntos de Hermes Agent 0.19, y Cron Ejecutar ahora se inicia de forma segura en segundo plano con una validación de creación más estricta (#2239, #2216, #2228)",new_0_6_34_7:"El escritorio añade ventanas de chat independientes y enfocadas, permite automatizar campos de contraseña, pago y archivos en el navegador, y conserva por separado el nombre y la descripción de cada miembro humano en cada sala de Group Chat (#2209, #2210, #2212)",new_0_6_34_8:"El comando /yolo por sesión alterna la omisión de aprobaciones, desaparece el límite visual de 200 turnos del Agent, Markdown conserva las comillas ASCII rectas y el catálogo pt-BR recupera los signos diacríticos que faltaban (#2223, #2225, #2234, #2221)",new_0_6_34_9:"Los dispositivos ESP32-C3 incorporan un modo de espera conectado configurable que reduce el consumo inactivo sin perder Wi-Fi, sesión, Profile ni Socket.IO, con activación inmediata y tiempo de espera persistente (#2218)",new_0_6_33_1:"Esta versión incluye los 16 PR fusionados después de 0.6.32: Agent Browser de escritorio, evidencias y plazos de ejecución de Workflow, interacción con archivos y chats, actualización de modelos Provider y mejoras de fiabilidad",new_0_6_33_2:"El escritorio incorpora un Agent Browser visible con varias pestañas, Profiles aislados, controles de proxy, almacenamiento y descargas, cookies persistentes cifradas, acciones de Agent protegidas y descubrimiento diferido de herramientas MCP (#2177, #2182)",new_0_6_33_3:"Los enlaces de chats individuales y grupales y las vistas HTML autenticadas se abren en el navegador integrado; también mejoran el espaciado de permisos, los iconos de navegación multiplataforma y la coordinación entre barra lateral y barra de título en Windows (#2191, #2194, #2198)",new_0_6_33_4:"Las ejecuciones de Workflow conservan la vista inmutable del inicio, muestran un plazo total para Run/Rerun con tiempo transcurrido y restante, y presentan historial y detalles en páginas basadas en la ruta realmente consumida (#2171, #2173, #2180)",new_0_6_33_5:"Los archivos se pueden pegar directamente en chats individuales o grupales, o adjuntar desde el menú contextual del workspace; las columnas de metadatos compactas dejan más espacio para los nombres (#2175, #2176)",new_0_6_33_6:"Cada Provider configurado puede actualizar su catálogo por separado, confirmar eliminaciones, conservar modelos predeterminados no disponibles y restaurar una vez; se incluyen Provider OAuth, localización completa y control del autocompletado de formularios (#2115)",new_0_6_33_7:"Los estados de interrupción y pausa se aíslan por sesión para que los chats en segundo plano no alteren el botón de parada activo; las selecciones de texto y los campos del escritorio también incorporan acciones nativas con clic derecho (#2203, #2204)",new_0_6_33_8:"El cierre, la actualización y la instalación de escritorio usan una finalización gradual con límite y solo fuerzan los árboles de procesos restantes de Agent Bridge, MCP, navegador y Web UI tras vencer el plazo de limpieza (#2193)",new_0_6_33_9:"Las sesiones de voz MCU aíslan los resultados en primer y segundo plano, mientras los nombres de herramientas MCP compatibles con MiniMax respetan el límite del Provider sin romper clientes existentes (#2181, #2169)",new_0_6_32_1:"Esta versión incluye los 14 PR fusionados después de 0.6.31: organización y compresión de sesiones, chat grupal, enrutamiento de Workflow, Skill Bundles, memoria de Ekko, Hermes 0.19 y marco de escritorio",new_0_6_32_2:"Las menciones del chat grupal ya funcionan después de texto CJK, emojis y puntuación; los propietarios pueden ver, generar y rotar códigos de invitación en los ajustes de la sala (#2133, #2141)",new_0_6_32_3:"Workflow conserva el origen de cada ejecución de Hermes Bridge durante transferencias y reconexiones; los nodos Codex y Claude Code con ámbito pueden usar protocolos compatibles con su launcher para destinos válidos con API Key (#2137, #2154)",new_0_6_32_4:"Las sesiones incorporan categorías globales, búsqueda más precisa que entiende Markdown y compresión por cursor que limita el historial y mantiene la corrección ante ediciones, ramas y ejecuciones simultáneas; el diseño de compresión está documentado por completo (#2139, #2143, #2145, #2146)",new_0_6_32_5:"Los Skill Bundles del Profile se pueden crear, explorar, ejecutar y eliminar directamente desde el chat, mostrando claramente los Skills incluidos (#2156)",new_0_6_32_6:"La memoria de Ekko usa ahora un único modelo canónico aislado por Profile, con cambios validados por revisión, mejor auditoría de fuentes y filtrado de relevancia más estricto (#2159)",new_0_6_32_7:"Los mensajes intermedios del asistente de Hermes 0.19 se transmiten y guardan como burbujas separadas; los chats individuales normales pueden entregar de forma asíncrona resultados duraderos de delegaciones en segundo plano (#2160)",new_0_6_32_8:"Las nuevas compilaciones del Runtime de escritorio, rutas alternativas y shims de CLI para Windows usan Hermes Agent 0.19.0 de forma predeterminada (#2161)",new_0_6_32_9:"Los controles de ventana se integran en el marco de la página: los semáforos de macOS están en la barra lateral, los controles de Windows sobre el contenido principal y Linux mantiene la decoración nativa (#2162)",new_0_6_32_10:"La documentación de desarrollo admite tanto el checkout actual como worktrees de Git aislados opcionales (#2155)"}};export{e as default};
