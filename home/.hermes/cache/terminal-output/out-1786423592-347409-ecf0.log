== service file ==
# /var/home/charlie/.config/systemd/user/hermes-web-ui.service
[Unit]
Description=Hermes Web UI (:8648 via FRP, service on :18648)
After=network-online.target
Wants=network-online.target

[Service]
PIDFile=/var/home/charlie/.hermes-web-ui/server.pid
Type=forking
Environment=HOME=%h
Environment=PATH=%h/.nvm/versions/node/current/bin:%h/.cargo/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=CORS_ORIGINS=*
Environment=PORT=18648
ExecStart=%h/.local/bin/hermes-web-ui-launch.sh start --no-open --port 18648
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

# /usr/lib/systemd/user/service.d/10-timeout-abort.conf
# This file is part of the systemd package.
# See https://fedoraproject.org/wiki/Changes/Shorter_Shutdown_Timer.
#
# To facilitate debugging when a service fails to stop cleanly,
# TimeoutStopFailureMode=abort is set to "crash" services that fail to stop in
# the time allotted. This will cause the service to be terminated with SIGABRT
# and a coredump to be generated.
#
# To undo this configuration change, create a mask file:
#   sudo mkdir -p /etc/systemd/user/service.d
#   sudo ln -sv /dev/null /etc/systemd/user/service.d/10-timeout-abort.conf

[Service]
TimeoutStopFailureMode=abort

# /var/home/charlie/.config/systemd/user/hermes-web-ui.service.d/env.conf
[Service]
Environment="HERMES_AGENT_BRIDGE_STOP_ON_SHUTDOWN=0"
Environment="HERMES_WEB_UI_SHUTDOWN_FORCE_EXIT_MS=60000"

# /var/home/charlie/.config/systemd/user/hermes-web-ui.service.d/override.conf
[Service]
Restart=no
TimeoutStopSec=25s
KillMode=control-group
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
MemoryHigh=10G
MemoryMax=14G
TasksMax=1024
CPUWeight=100
IOWeight=100
