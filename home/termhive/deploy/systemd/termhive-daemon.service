[Unit]
Description=TermHive agent runtime daemon
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/termhive
Environment=HOME=%h
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=TERMHIVE_DAEMON_PORT=3210
Environment=PATH=%h/.nvm/versions/node/v22.22.3/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.nvm/versions/node/v22.22.3/bin/node %h/termhive/dist/daemon/daemon.js
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
