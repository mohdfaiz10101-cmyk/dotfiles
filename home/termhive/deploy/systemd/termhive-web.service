[Unit]
Description=TermHive authenticated web control plane
After=network-online.target termhive-daemon.service
Wants=network-online.target
Requires=termhive-daemon.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/termhive
Environment=HOME=%h
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=HOST=127.0.0.1
Environment=PORT=3200
Environment=TERMHIVE_DAEMON_PORT=3210
Environment=PATH=%h/.nvm/versions/node/v22.22.3/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/termhive/server.env
ExecStart=%h/.nvm/versions/node/v22.22.3/bin/node %h/termhive/dist/server.js
Restart=always
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.termhive %h/termhive

[Install]
WantedBy=default.target
