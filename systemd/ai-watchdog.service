[Unit]
Description=AI Task Pipeline Watchdog
After=network.target glm-proxy.service

OnFailure=sentinel-onfailure@ai-watchdog.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/ai-watchdog --daemon
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target

