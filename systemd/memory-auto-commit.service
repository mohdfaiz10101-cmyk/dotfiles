[Unit]
Description=Memory Auto Commit — 记忆文件变更即git commit (dotfiles)
After=network.target

OnFailure=sentinel-onfailure@memory-auto-commit.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=simple
ExecStart=/run/current-system/sw/bin/bash %h/.local/bin/memory-auto-commit
Restart=always
RestartSec=15
Environment="HOME=%h"
WorkingDirectory=%h

[Install]
WantedBy=default.target
