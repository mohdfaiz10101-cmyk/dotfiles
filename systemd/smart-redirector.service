[Unit]
Description=OpenCode 智能路由跳转 (:8088)
After=network.target
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=simple
ExecStart=/run/current-system/sw/bin/python3 /home/charlie/.local/bin/smart-redirector.py
Restart=on-failure
RestartSec=10
Environment=HOME=/home/charlie
Environment=PATH=/run/current-system/sw/bin:/home/charlie/.local/bin:/home/charlie/.npm-global/bin:/home/charlie/.nix-profile/bin

[Install]
WantedBy=default.target