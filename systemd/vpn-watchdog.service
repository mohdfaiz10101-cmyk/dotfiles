[Unit]
Description=VPN Watchdog — 自动拉起手机/平板 Karing+Tailscale
After=network-online.target tailscaled.service tablet-adb-watch.service

OnFailure=sentinel-onfailure@vpn-watchdog.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/vpn-watchdog
Restart=always
RestartSec=15
Environment=HOME=/home/charlie
Environment=PATH=/home/charlie/.local/bin:/run/current-system/sw/bin:/usr/bin:/bin

[Install]
WantedBy=default.target

