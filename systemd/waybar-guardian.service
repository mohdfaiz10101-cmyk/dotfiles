[Unit]
Description=Waybar Guardian Monitor
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/waybar-guardian.py --daemon
Restart=always
RestartSec=10
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/charlie/.Xauthority

[Install]
WantedBy=graphical-session.target
