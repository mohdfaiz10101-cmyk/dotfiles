[Unit]
Description=Headless Browser API Server
After=network.target

[Service]
Type=simple
ExecStart=/run/current-system/sw/bin/node /home/charlie/launcher/headless-browser-server.js
WorkingDirectory=/home/charlie/launcher
Restart=on-failure
RestartSec=5
Environment=NODE_PATH=/tmp/node_modules

[Install]
WantedBy=default.target
