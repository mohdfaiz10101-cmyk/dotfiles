[Unit]
Description=The Companion - Web UI for Claude Code
After=network.target

[Service]
Type=simple
ExecStartPre=-/bin/sh -c 'ss -tlnp | grep -q ":3456 " && echo "PORT 3456 IN USE" && exit 1 || true'
ExecStart=/home/charlie/.bun/bin/the-companion start --foreground
OnFailure=sentinel-onfailure@the-companion.service
WorkingDirectory=/home/charlie
Restart=always
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
RestartSec=10
SuccessExitStatus=42
StandardOutput=append:/home/charlie/.companion/logs/companion.log
StandardError=append:/home/charlie/.companion/logs/companion.error.log
Environment=NODE_ENV=production
Environment=PORT=3456
Environment=HOME=/home/charlie
Environment=PATH=/home/charlie/.bun/bin:/home/charlie/.local/bin:/home/charlie/go/bin:/home/charlie/.opencode/bin:/run/wrappers/bin:/home/charlie/.local/share/flatpak/exports/bin:/var/lib/flatpak/exports/bin:/home/charlie/.nix-profile/bin:/nix/profile/bin:/home/charlie/.local/state/nix/profile/bin:/etc/profiles/per-user/charlie/bin:/nix/var/nix/profiles/default/bin:/run/current-system/sw/bin:/usr/bin:/bin

[Install]
WantedBy=default.target


