[Unit]
Description=OpenCode Telegram 任务处理器
After=network.target
StartLimitIntervalSec=30
OnFailure=sentinel-onfailure@opencode-telegram-processor.service

StartLimitAction=none
StartLimitBurst=5
[Service]
Type=simple
Environment="PATH=%h/.npm-global/bin:/run/current-system/sw/bin"
ExecStart=%h/.local/bin/opencode-telegram-processor
Restart=always
RestartSec=10

[Install]
WantedBy=default.target

