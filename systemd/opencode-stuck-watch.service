[Unit]
Description=OpenCode Stuck Session Watchdog
After=opencode-web.service
PartOf=opencode-web.service
StartLimitIntervalSec=30
OnFailure=sentinel-onfailure@opencode-stuck-watch.service

StartLimitAction=none
StartLimitBurst=5
[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/opencode-stuck-watch.sh
Restart=always
RestartSec=10

[Install]
WantedBy=default.target

