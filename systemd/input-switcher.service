[Unit]
Description=Input Method Auto-Switcher
After=display-manager.service
Wants=display-manager.service

[Service]
Type=simple
User=charlie
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/charlie/.Xauthority
ExecStart=/home/charlie/.config/input-switcher/input-switcher.sh
OnFailure=sentinel-onfailure@input-switcher.service
Restart=always
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
RestartSec=10

[Install]
WantedBy=graphical-session.target

