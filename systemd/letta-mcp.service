[Unit]
Description=Letta Memory MCP Server (HTTP)
After=network.target
StartLimitIntervalSec=30
OnFailure=sentinel-onfailure@letta-mcp.service

StartLimitAction=none
StartLimitBurst=5
[Service]
EnvironmentFile=%h/dotfiles/systemd/service-common.env
Type=simple
ExecStart=/home/charlie/.local/bin/letta-mcp-server
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target

