[Unit]
Description=CRM Static Server (port 9876)
After=network.target

[Service]
Type=simple
ExecStartPre=-/bin/sh -c 'ss -tlnp | grep -q ":9876 " && echo "PORT 9876 IN USE" && exit 1 || true'
ExecStart=/run/current-system/sw/bin/python3 /mnt/ai/apps/crm/serve_crm.py
OnFailure=sentinel-onfailure@crm-server.service
Restart=on-failure
StartLimitAction=none
StartLimitBurst=3
StartLimitIntervalSec=60
RestartSec=10

[Install]
WantedBy=default.target


