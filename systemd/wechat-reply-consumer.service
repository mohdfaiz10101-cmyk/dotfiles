[Unit]
Description=微信自动回复消费者
After=default.target

[Service]
Type=simple
ExecStart=/run/current-system/sw/bin/python3 %h/.local/bin/wechat-reply-consumer.py
OnFailure=sentinel-onfailure@wechat-reply-consumer.service
Restart=on-failure
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
RestartSec=10
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority

[Install]
WantedBy=default.target

