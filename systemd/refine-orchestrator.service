[Unit]
Description=Refine Orchestrator — Self-Play + MoA 编排服务
After=network.target litellm.service

[Service]
Type=simple
WorkingDirectory=/mnt/ai/refine-orchestrator
ExecStart=/run/current-system/sw/bin/python3 -m uvicorn refine_api:app --host 127.0.0.1 --port 9820 --log-level warning
Restart=on-failure
RestartSec=10
Environment="PATH=/run/current-system/sw/bin:/usr/bin"

[Install]
WantedBy=default.target
