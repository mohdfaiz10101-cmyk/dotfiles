[Unit]
Description=Tmux Claude 工作会话
After=graphical-session.target

[Service]
Type=forking
ExecStart=/run/current-system/sw/bin/tmux new-session -d -s claude-work -n "Claude工作"
ExecStop=/run/current-system/sw/bin/tmux kill-session -t claude-work
RemainAfterExit=yes
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
