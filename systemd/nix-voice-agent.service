[Unit]
Description=NixOS Voice Agent
After=network.target

[Service]
ExecStart=/run/current-system/sw/bin/python3 /home/charlie/.local/bin/nix_voice_agent.py
OnFailure=sentinel-onfailure@nix-voice-agent.service
Restart=always
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
RestartSec=10

[Install]
WantedBy=default.target

