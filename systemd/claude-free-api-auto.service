[Unit]
Description=Claude 免费 API 自动切换守护进程
After=network.target

[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/claude-free-api-auto daemon
OnFailure=sentinel-onfailure@claude-free-api-auto.service
Restart=always
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
RestartSec=60

[Install]
WantedBy=default.target

