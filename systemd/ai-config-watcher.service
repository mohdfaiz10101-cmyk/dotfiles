[Unit]
Description=AI Config Real-time Watcher — inotify 监听配置变更
After=network-online.target

OnFailure=sentinel-onfailure@ai-config-watcher.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=simple
ExecStart=/run/current-system/sw/bin/bash /home/charlie/.local/bin/ai-config-watcher.sh
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target

