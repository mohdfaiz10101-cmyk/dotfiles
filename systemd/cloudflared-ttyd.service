[Unit]
Description=Cloudflare Tunnel — opencode Web UI 手机入口 (port 8080)
After=network-online.target opencode-web.service
Wants=opencode-web.service

[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/cloudflared-ttyd
Restart=on-failure
RestartSec=30
Environment=HOME=/home/charlie
Environment=PATH=/run/current-system/sw/bin:/home/charlie/.local/bin:/home/charlie/.nix-profile/bin

[Install]
WantedBy=default.target
