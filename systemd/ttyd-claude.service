[Unit]
Description=ttyd - Claude Code Terminal (:7690)
After=network.target

[Service]
Type=simple
ExecStart=/run/current-system/sw/bin/ttyd -b /ttyd -I /home/charlie/.local/share/ttyd/index.html -p 7690 -P 10 -t fontSize=13 -t scrollback=50000 -W /home/charlie/.local/bin/claude-tmux-wrap
Restart=on-failure
RestartSec=5
Environment=HOME=/home/charlie
Environment=PATH=/run/current-system/sw/bin:/home/charlie/.local/bin:/home/charlie/.nix-profile/bin
Environment=TERM=xterm-256color
Environment=COLORTERM=truecolor

[Install]
WantedBy=default.target
