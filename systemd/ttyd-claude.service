[Unit]
Description=ttyd - Claude Code Terminal (:7690)
After=network.target

[Service]
Type=simple
ExecStart=/run/current-system/sw/bin/ttyd -p 7690 -t fontSize=14 -t theme={"background":"#1a1a2e","foreground":"#e0e0e8"} -W /run/current-system/sw/bin/bash -c "claude p"
Restart=on-failure
RestartSec=5
Environment=HOME=/home/charlie
Environment=PATH=/run/current-system/sw/bin:/home/charlie/.local/bin:/home/charlie/.nix-profile/bin

[Install]
WantedBy=default.target
