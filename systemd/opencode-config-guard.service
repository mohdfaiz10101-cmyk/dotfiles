[Unit]
Description=OpenCode 配置文件循环链接 inotify 守护
After=default.target

[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/opencode-config-guard.sh --daemon
OnFailure=sentinel-onfailure@opencode-config-guard.service
Restart=always
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
RestartSec=10
Environment=HOME=/home/charlie
Environment=PATH=/run/current-system/sw/bin:/home/charlie/.local/bin

[Install]
WantedBy=default.target
