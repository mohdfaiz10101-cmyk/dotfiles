[Unit]
Description=Cloudflare Quick Tunnel — AI Launcher (7699)
After=network-online.target opencode-web.service
Wants=opencode-web.service

OnFailure=sentinel-onfailure@cloudflared-launcher.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/cloudflared-launcher
Restart=on-failure
RestartSec=30
Environment=HOME=/home/charlie
Environment=PATH=/run/current-system/sw/bin:/home/charlie/.local/bin:/home/charlie/.nix-profile/bin

[Install]
WantedBy=default.target

