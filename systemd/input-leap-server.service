[Unit]
Description=Input Leap Server (Keyboard/Mouse/Clipboard sharing)
After=graphical-session.target

OnFailure=sentinel-onfailure@input-leap-server.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=simple
ExecStart=/home/charlie/.nix-profile/bin/input-leaps -f -c %h/.config/input-leap.conf --no-daemon
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target

