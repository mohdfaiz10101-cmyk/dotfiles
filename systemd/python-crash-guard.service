[Unit]
Description=Python 关键服务崩溃实时监控
After=default.target

OnFailure=sentinel-onfailure@python-crash-guard.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/python-crash-guard.sh
Restart=always
RestartSec=10

[Install]
WantedBy=default.target

