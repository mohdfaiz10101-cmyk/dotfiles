[Unit]
Description=Haven MCP Telegram Bot
After=network-online.target haven-mcp-proxy.service
Requires=haven-mcp-proxy.service

[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/haven-mcp-telegram.sh loop
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
