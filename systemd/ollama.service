[Unit]
Description=Ollama Local LLM Server
After=network.target

[Service]
Type=simple
ExecStart=/home/charlie/.nix-profile/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_ORIGINS=*
Environment=OLLAMA_MODELS=/mnt/ai/apps/ollama/models
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
