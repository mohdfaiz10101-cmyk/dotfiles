[Unit]
Description=Ollama Local LLM Server
After=network.target

OnFailure=sentinel-onfailure@ollama.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/ollama-cuda serve
Environment=OLLAMA_MODELS=/mnt/ai/models/ollama
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target

