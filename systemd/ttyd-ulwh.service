[Unit]
Description=ttyd - ULWh Terminal (:7696)
After=network.target

OnFailure=sentinel-onfailure@ttyd-ulwh.service
StartLimitAction=none
StartLimitBurst=3
StartLimitIntervalSec=60
[Service]
Type=simple
ExecStartPre=-/bin/sh -c 'fuser -k 7696/tcp 2>/dev/null; sleep 0.5; true'
ExecStart=/run/current-system/sw/bin/ttyd -P 3 -p 7696 --base-path /ulwh -t fontSize=14 -t disableLeaveAlert=true -t scrollback=50000 -t rendererType=canvas -W /home/charlie/.local/bin/ulwh-tmux-wrap
Restart=on-failure
RestartSec=10
Environment=HOME=/home/charlie
Environment=PATH=/run/current-system/sw/bin:/home/charlie/.local/bin:/home/charlie/.nix-profile/bin
Environment=TERM=xterm-256color
Environment=COLORTERM=truecolor

[Install]
WantedBy=default.target


