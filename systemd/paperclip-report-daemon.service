[Unit]
Description=Paperclip Agent Report Daemon
Documentation=https://paperclip.ing
After=graphical-session.target network.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/paperclip-report-daemon.sh
Restart=on-failure
RestartSec=30s

# Paperclip API 配置
Environment=PAPERCLIP_API_URL=http://127.0.0.1:3100
Environment=PAPERCLIP_COMPANY_ID=aae8a73b-784f-4815-9511-bec8f2409b75
Environment=POLL_INTERVAL=30
EnvironmentFile=%h/.config/paperclip/secrets.env

# 桌面通知需要 DISPLAY 和 DBUS（动态获取用户 ID）
Environment=DISPLAY=:0
Environment=PATH=/run/current-system/sw/bin:/home/charlie/.nix-profile/bin:/usr/bin:/bin

# 日志由 journald 管理，脚本内部也会写入 daemon.log
StandardOutput=journal
StandardError=journal
SyslogIdentifier=paperclip-report-daemon

[Install]
WantedBy=default.target
