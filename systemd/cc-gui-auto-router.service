[Unit]
Description=CC-GUI Auto Router (GLM/DeepSeek smart dispatch)
After=network.target

OnFailure=sentinel-onfailure@cc-gui-auto-router.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/cc-gui-auto-router
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target

