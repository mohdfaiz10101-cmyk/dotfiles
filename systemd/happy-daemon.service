[Unit]
Description=Happy CLI Daemon (Claude Code On the Go)
After=network-online.target mnt-pool\\x2ddisks-POOL\\x2dD1.mount
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/charlie/.npm-global/bin/happy daemon start-sync
ExecStopPost=/home/charlie/.local/bin/tg-push "⚠️ Happy daemon 重启，请在手机 App 开新会话"
Restart=on-failure
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
RestartSec=10
Environment=PATH=/home/charlie/.npm-global/bin:/run/current-system/sw/bin:/usr/bin:/bin
Environment=HOME=/home/charlie
Environment=HAPPY_CLAUDE_PATH=/run/current-system/sw/bin/claude

[Install]
WantedBy=default.target

