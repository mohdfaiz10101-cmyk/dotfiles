[Unit]
Description=Tech Digest Web Viewer
After=network-online.target

OnFailure=sentinel-onfailure@tech-digest-viewer.service
StartLimitAction=none
StartLimitBurst=3
StartLimitIntervalSec=60
[Service]
Type=simple
ExecStart=/run/current-system/sw/bin/python3 /home/charlie/launcher/tech-digest-viewer.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target

