[Unit]
Description=Chronos Subconscious — Dream Analysis Engine
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/run/current-system/sw/bin/python3 /home/charlie/launcher/chronos-subconscious.py
Environment=HOME=/home/charlie
Environment=PATH=/run/current-system/sw/bin:/home/charlie/.local/bin:/usr/bin:/bin
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chronos-subconscious
