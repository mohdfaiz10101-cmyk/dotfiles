[Unit]
Description=Overcode 循环检测器
After=network.target

OnFailure=sentinel-onfailure@overcode-loop-watch.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/overcode-loop-watch.sh
Restart=always
RestartSec=10
Environment=HOME=/home/charlie
Environment=PATH=/run/current-system/sw/bin:/home/charlie/.local/bin

[Install]
WantedBy=default.target

