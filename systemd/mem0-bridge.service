[Unit]
Description=Mem0 Bridge (轻量短期记忆服务)
After=network.target embedding-server.service

OnFailure=sentinel-onfailure@mem0-bridge.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/mem0-bridge-wrapper
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target

