[Unit]
Description=Screenshot Intent Watcher (GLM-4.6V-Flash)
After=network.target

OnFailure=sentinel-onfailure@screenshot-watcher.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
EnvironmentFile=%h/dotfiles/systemd/service-common.env
Type=simple
ExecStart=/home/charlie/.local/bin/screenshot-watcher.sh
Restart=always
RestartSec=10

[Install]
WantedBy=default.target

