[Unit]
Description=Cloudflare Tunnel for TG Canvas
After=network-online.target tg-canvas.service
Wants=network-online.target tg-canvas.service

OnFailure=sentinel-onfailure@cloudflared-tg-canvas.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=simple
ExecStartPre=-/bin/sh -c 'ss -tlnp | grep -q ":3721 " && echo "PORT 3721 IN USE" && exit 1 || true'
ExecStart=/home/charlie/.nix-profile/bin/cloudflared tunnel --url http://localhost:3721 --no-autoupdate
Restart=always
RestartSec=10

[Install]
WantedBy=default.target


