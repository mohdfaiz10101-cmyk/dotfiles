[Unit]
Description=AI Launcher — 手机统一入口 (:7699)
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/ai/apps/launcher
ExecStart=/nix/store/nyijib6swbd9a6644g7ccaxbd51nq4ib-caddy-2.11.2/bin/caddy run --config /mnt/ai/apps/launcher/Caddyfile
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
