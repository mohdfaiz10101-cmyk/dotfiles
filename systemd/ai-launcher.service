[Unit]
Description=AI Launcher — 手机统一入口 (:7699)
After=network.target mnt-ai.mount
Requires=mnt-ai.mount

[Service]
Type=simple
WorkingDirectory=/mnt/ai/apps/launcher
ExecStart=%h/.nix-profile/bin/caddy run --config /mnt/ai/apps/launcher/Caddyfile
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
