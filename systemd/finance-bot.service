[Unit]
Description=Finance Telegram Bot (@charlie_finbot)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/charlie/agi
EnvironmentFile=-/home/charlie/agi/.env
ExecStart=/home/charlie/agi/.venv/bin/python /home/charlie/agi/finance_bot.py
Restart=on-failure
RestartSec=15
Environment=HOME=/home/charlie
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
