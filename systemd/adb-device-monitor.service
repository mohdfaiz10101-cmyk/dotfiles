[Unit]
Description=ADB Device Monitor (auto-connect USB/WiFi)
After=network-online.target

OnFailure=sentinel-onfailure@adb-device-monitor.service
StartLimitAction=none
StartLimitIntervalSec=60
StartLimitBurst=3
[Service]
Type=simple
ExecStart=/run/current-system/sw/bin/python3 %h/.local/bin/adb-device-monitor.py
Restart=on-failure
RestartSec=30
# 5分钟内最多3次重启，防止 SIGABRT 死循环

[Install]
WantedBy=default.target

