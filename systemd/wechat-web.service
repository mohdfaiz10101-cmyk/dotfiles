[Unit]
Description=WeChat Message Review Web UI (port 9097)
After=network.target

OnFailure=sentinel-onfailure@wechat-web.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=simple
WorkingDirectory=/mnt/ai/ai-cluster/wechat-sync
ExecStartPre=-/bin/sh -c 'ss -tlnp | grep -q ":9097 " && echo "PORT 9097 IN USE" && exit 1 || true'
ExecStart=/run/current-system/sw/bin/python3 web.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target


