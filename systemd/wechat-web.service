[Unit]
Description=WeChat Message Review Web UI (port 9097)
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/ai/ai-cluster/wechat-sync
ExecStart=/run/current-system/sw/bin/python3 web.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
