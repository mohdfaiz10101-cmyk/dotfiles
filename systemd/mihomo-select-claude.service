[Unit]
Description=Force mihomo to use Claude-compatible proxy
After=mihomo.service
Requires=mihomo.service

[Service]
Type=oneshot
ExecStart=/run/current-system/sw/bin/bash -c 'sleep 5 && curl -X PUT http://127.0.0.1:9091/proxies/GLOBAL -H "Content-Type: application/json" -d "{\"name\": \"B - 🇺🇸 US 15 TG: @nodpai\"}"'

[Install]
WantedBy=default.target
