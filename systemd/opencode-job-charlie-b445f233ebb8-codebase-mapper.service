[Unit]
Description=OpenCode Job: codebase-mapper

[Service]
Type=oneshot
WorkingDirectory=/home/charlie
Environment="PATH=/run/current-system/sw/bin:/home/charlie/.local/bin:/usr/bin:/bin"
ExecStart=/home/charlie/.local/bin/op-adaptive-gate codebase-mapper /run/current-system/sw/bin/perl /home/charlie/.config/opencode/scheduler/scopes/charlie-b445f233ebb8/jobs/codebase-mapper.json
StandardOutput=append:/home/charlie/.config/opencode/logs/scheduler/charlie-b445f233ebb8/codebase-mapper.log
StandardError=append:/home/charlie/.config/opencode/logs/scheduler/charlie-b445f233ebb8/codebase-mapper.log
TimeoutStartSec=600

[Install]
WantedBy=default.target
