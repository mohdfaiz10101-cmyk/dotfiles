[Unit]
Description=ttyd - Hermes Terminal (:7689)
After=network.target

[Service]
Type=simple
ExecStartPre=-/bin/sh -c 'fuser -k 7689/tcp 2>/dev/null; sleep 0.5; true'
ExecStart=/run/current-system/sw/bin/ttyd -p 7689 -P 3 -I /home/charlie/.local/share/ttyd/index.html -t fontSize=10 -t disableLeaveAlert=true -t 'theme={"background":"#1a1a2e","foreground":"#e0e0e8"}' -t scrollback=50000 -W tmux new-session -A -s hermes
ExecStop=/bin/sh -c 'fuser -k 7689/tcp 2>/dev/null || true'
Restart=on-failure
RestartSec=10
Environment=HOME=/home/charlie
Environment=PATH=/run/current-system/sw/bin:/home/charlie/.local/bin:/home/charlie/.npm-global/bin:/home/charlie/.nix-profile/bin
Environment=TERM=xterm-256color
Environment=COLORTERM=truecolor

[Install]
WantedBy=default.target