[Unit]
Description=Chronos Bio-feedback — Screen Time & Eye Protection
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=/run/current-system/sw/bin/python3 /home/charlie/launcher/chronos-biofeedback.py
Environment=HOME=/home/charlie
Environment=PATH=/run/current-system/sw/bin:/home/charlie/.local/bin:/usr/bin:/bin
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-1
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chronos-biofeedback

[Install]
WantedBy=graphical-session.target
