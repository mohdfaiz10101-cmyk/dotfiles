[Unit]
Description=Finance Agent API
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/charlie/agi/finance
ExecStart=/home/charlie/agi/.venv/bin/python3 -m uvicorn finance_agent:app --host 0.0.0.0 --port 9811 --log-level warning
Restart=on-failure
RestartSec=10
Environment=HOME=/home/charlie

[Install]
WantedBy=default.target
