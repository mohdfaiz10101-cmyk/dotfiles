[Unit]
Description=GLM Monitor Web Server
After=glm-proxy.service

[Service]
Type=simple
ExecStart=/run/current-system/sw/bin/python3 /home/charlie/.local/bin/glm-monitor
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:%h/.local/bin

[Install]
WantedBy=default.target
