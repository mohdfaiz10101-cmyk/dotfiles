[Unit]
Description=Phone AI Bridge — keep ADB + stay-on
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=30
OnFailure=sentinel-onfailure@phone-ai-bridge.service

[Service]
Type=simple
ExecStart=%h/.local/bin/phone-ai-bridge.sh
Restart=on-failure
StartLimitAction=none
RestartSec=30

[Install]
WantedBy=default.target

