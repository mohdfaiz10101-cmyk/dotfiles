[Unit]
Description=LangChain Hub Web Viewer (port 8899)
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/ai/ai-cluster/langchain-hub
ExecStart=/mnt/ai/ai-cluster/langchain-hub/venv/bin/python web_viewer.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
