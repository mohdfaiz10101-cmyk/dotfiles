[Unit]
Description=Paperclip AI Agent Orchestration Platform
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/ai/ai-cluster/paperclip
ExecStart=/run/current-system/sw/bin/corepack pnpm --filter @paperclipai/server dev
Restart=on-failure
RestartSec=10
Environment=NODE_ENV=development
Environment=PORT=3100
Environment=PATH=/home/charlie/.local/bin:%h/.nix-profile/bin:/nix/profile/bin:%h/.local/state/nix/profile/bin:/etc/profiles/per-user/charlie/bin:/nix/var/nix/profiles/default/bin:/run/current-system/sw/bin:/run/wrappers/bin

[Install]
WantedBy=default.target
