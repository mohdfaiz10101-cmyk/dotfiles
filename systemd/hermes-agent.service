[Unit]
Description=Hermes Agent — Self-Learning AI Runtime
After=network-online.target mnt-pool\x2ddisks-POOL\x2dB1.mount
Wants=network-online.target mnt-pool\x2ddisks-POOL\x2dB1.mount
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
ExecStart=/mnt/ai/hermes-venv/bin/hermes gateway run
Restart=always
RestartSec=10
TimeoutStopSec=30
TimeoutStartSec=60
SuccessExitStatus=0 143
KillMode=control-group
Environment=HOME=%h
Environment=USER=%u
Environment=PATH=%h/.local/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
Environment=HERMES_MODEL=litellm/step-3.5-flash-2603
Environment=HERMES_PROVIDER=litellm
Environment=LITELLM_API_KEY=sk-litellm-charlie-2026
Environment=LITELLM_BASE_URL=http://localhost:4000
Environment=HTTPS_PROXY=http://127.0.0.1:7890
Environment=HTTP_PROXY=http://127.0.0.1:7890

[Install]
WantedBy=default.target
