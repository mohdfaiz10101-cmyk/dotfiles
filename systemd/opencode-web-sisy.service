[Unit]
Description=OpenCode Web Sisyphus (port 8090)
After=network.target
StartLimitIntervalSec=30
StartLimitBurst=5
OnFailure=sentinel-onfailure@opencode-web-sisy.service

[Service]
Type=simple
ExecStartPre=-/bin/sh -c 'ss -tlnp | grep -q ":7699 " && echo "PORT 7699 IN USE" && exit 1 || true'
ExecStart=/home/charlie/dotfiles/scripts/wait-for-litellm.sh /home/charlie/.npm-global/bin/opencode web --port 8090 --hostname 0.0.0.0 --cors http://localhost:7699 --cors http://localhost:8090
Restart=on-failure
StartLimitAction=none
RestartSec=10
TimeoutStopSec=300
KillSignal=SIGTERM
KillMode=mixed
Environment=HOME=/home/charlie
Environment=PATH=/run/current-system/sw/bin:/home/charlie/.local/bin:/home/charlie/.nix-profile/bin
WorkingDirectory=/home/charlie

[Install]
WantedBy=default.target


