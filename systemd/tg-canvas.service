[Unit]
Description=Telegram Mini App Canvas Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/ai/apps/openclaw-tg-canvas
EnvironmentFile=/mnt/ai/apps/openclaw-tg-canvas/.env
ExecStart=/run/current-system/sw/bin/node server.js
Restart=always
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
RestartSec=10

[Install]
WantedBy=default.target

