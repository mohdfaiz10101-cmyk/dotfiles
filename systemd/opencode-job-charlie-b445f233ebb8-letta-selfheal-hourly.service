[Unit]
Description=OpenCode Job: letta-selfheal-hourly

[Service]
Type=oneshot
WorkingDirectory=/home/charlie
Environment="PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
ExecStart="/usr/bin/perl" "/home/charlie/.config/opencode/scheduler/supervisor.pl" "/home/charlie/.config/opencode/scheduler/scopes/charlie-b445f233ebb8/jobs/letta-selfheal-hourly.json"
StandardOutput=append:/home/charlie/.config/opencode/logs/scheduler/charlie-b445f233ebb8/letta-selfheal-hourly.log
StandardError=append:/home/charlie/.config/opencode/logs/scheduler/charlie-b445f233ebb8/letta-selfheal-hourly.log

[Install]
WantedBy=default.target
