[Unit]
Description=OpenAgents Network Hub (port 8700/8600)
After=network.target

[Service]
Type=simple
ExecStartPre=-/bin/sh -c 'ss -tlnp | grep -q ":8700 " && echo "PORT 8700 IN USE" && exit 1 || true'
ExecStart=/home/charlie/.local/bin/openagents-network-wrapper.sh
OnFailure=sentinel-onfailure@openagents-network.service
WorkingDirectory=/home/charlie/.openagents/network
Environment=PATH=/mnt/ai/oa-venv/bin:/run/current-system/sw/bin:/home/charlie/.nix-profile/bin
Environment=PYTHONUNBUFFERED=1
Environment=LD_LIBRARY_PATH=/nix/store/ab3753m6i7isgvzphlar0a8xb84gl96i-gcc-15.2.0-lib/lib
Environment=http_proxy=
Environment=https_proxy=
Environment=HOME=/home/charlie
Restart=on-failure
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
RestartSec=10

[Install]
WantedBy=default.target


