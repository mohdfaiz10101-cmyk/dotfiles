[Unit]
Description=macg MCP Server (HTTP) — Windows OpenCode 记忆桥接
After=network-online.target
StartLimitIntervalSec=30
OnFailure=sentinel-onfailure@macg-mcp.service

[Service]
Type=simple
ExecStart=/home/charlie/agi/.venv/bin/python /home/charlie/agi/macg_mcp.py --http
Restart=always
StartLimitAction=none
StartLimitBurst=5
RestartSec=10
Environment="HOME=%h"
WorkingDirectory=/home/charlie/agi
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

