[Unit]
Description=macg MCP Server (HTTP) — Windows OpenCode 记忆桥接
After=network-online.target

[Service]
Type=simple
ExecStart=/home/charlie/agi/.venv/bin/python /home/charlie/agi/macg_mcp.py --http
Restart=always
RestartSec=5
Environment="HOME=%h"
WorkingDirectory=/home/charlie/agi
