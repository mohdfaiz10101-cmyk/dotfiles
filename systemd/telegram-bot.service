ExecStart=/run/current-system/sw/bin/python3 /mnt/ai/ai-cluster/hyperchat/telegram_bot.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=HTTPS_PROXY=http://127.0.0.1:7890
