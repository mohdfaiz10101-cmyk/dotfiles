[Unit]
Description=Telegram Bot API Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/ai/apps/telegram-bot
ExecStart=/mnt/ai/apps/telegram-bot/venv/bin/python /mnt/ai/apps/telegram-bot/bot_api.py
Restart=always
RestartSec=5
Environment="HOME=/home/charlie"
Environment="PATH=/run/current-system/sw/bin:/usr/bin:/bin"

[Install]
WantedBy=default.target
