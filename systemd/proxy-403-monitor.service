[Unit]
Description=Claude API 403 Real-time Monitor
After=network.target

OnFailure=sentinel-onfailure@proxy-403-monitor.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
EnvironmentFile=%h/dotfiles/systemd/service-common.env
Type=simple
ExecStart=%h/.local/bin/proxy-403-monitor
Restart=always
RestartSec=10

[Install]
WantedBy=default.target

