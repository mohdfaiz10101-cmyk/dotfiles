[Unit]
Description=Paperclip Fork Auto Sync - Merge upstream updates
After=network.target

[Service]
Type=oneshot
Environment="HTTPS_PROXY=http://127.0.0.1:7890"
Environment="https_proxy=http://127.0.0.1:7890"
ExecStart=/home/charlie/.local/bin/paperclip-auto-sync
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
