[Unit]
Description=ttyd - Aider Terminal (:7693)
After=network.target

OnFailure=sentinel-onfailure@ttyd-aider.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=simple
ExecStartPre=-/bin/sh -c 'fuser -k 7693/tcp 2>/dev/null; sleep 0.5; true'
ExecStart=/run/current-system/sw/bin/ttyd -b /aider -p 7693 -t fontSize=13 -t disableLeaveAlert=true -W /run/current-system/sw/bin/bash --login
Restart=on-failure
RestartSec=10
Environment=HOME=/home/charlie
Environment=PATH=/run/current-system/sw/bin:/home/charlie/.local/bin:/home/charlie/.nix-profile/bin
Environment=TERM=xterm-256color
Environment=COLORTERM=truecolor

[Install]
WantedBy=default.target


