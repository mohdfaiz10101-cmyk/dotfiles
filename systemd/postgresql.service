[Unit]
Description=PostgreSQL + pgvector for Letta
After=default.target

[Service]
Type=forking
Environment=PATH=/home/charlie/.nix-profile/bin:/run/current-system/sw/bin
Environment=PGDATA=/mnt/ai/apps/postgresql/data
Environment=PGLOG=/mnt/ai/apps/postgresql/logfile
RuntimeDirectory=postgresql
ExecStart=/home/charlie/.nix-profile/bin/pg_ctl -D ${PGDATA} -l ${PGLOG} -o "-c unix_socket_directories=/run/user/1000/postgresql" start
ExecStop=/home/charlie/.nix-profile/bin/pg_ctl -D ${PGDATA} stop
ExecReload=/home/charlie/.nix-profile/bin/pg_ctl -D ${PGDATA} reload
PIDFile=/mnt/ai/apps/postgresql/data/postmaster.pid
Restart=on-failure
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
RestartSec=10

[Install]
WantedBy=default.target
WantedBy=letta.service

