# CC 自主决策引擎 systemd timer
# 注意：OnCalendar 时间必须在 08:00-22:00 之间（TIMER_HOURS 规则）

[Unit]
Description=CC 自主决策引擎 - 分析状态并派发 OP 任务
After=network.target

[Service]
Type=oneshot
User=charlie
Environment="PATH=/run/current-system/sw/bin"
ExecStart=/home/charlie/.local/bin/cc-decision-engine.py
WorkingDirectory=/home/charlie

# 超时保护
TimeoutSec=300

# 标准输出重定向到 journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target