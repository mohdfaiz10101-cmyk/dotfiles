[Unit]
Description=OpenCode Job: security-watchdog

[Service]
Type=oneshot
WorkingDirectory=/home/charlie
Environment="PATH=/run/current-system/sw/bin:/home/charlie/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
ExecStart="/run/current-system/sw/bin/perl" "/home/charlie/.config/opencode/scheduler/supervisor.pl" "/home/charlie/.config/opencode/scheduler/scopes/charlie-b445f233ebb8/jobs/security-watchdog.json"
StandardOutput=append:/home/charlie/.config/opencode/logs/scheduler/charlie-b445f233ebb8/security-watchdog.log
StandardError=append:/home/charlie/.config/opencode/logs/scheduler/charlie-b445f233ebb8/security-watchdog.log
TimeoutStartSec=600

[Install]
WantedBy=default.target
