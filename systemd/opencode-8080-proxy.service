[Unit]
Description=TCP Proxy 8080->8081 for OpenCode external access
After=network.target opencode-web.service
Wants=opencode-web.service

OnFailure=sentinel-onfailure@opencode-8080-proxy.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/opencode-8080-proxy.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

