[Unit]
Description=Waybar status bar for Hyprland
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/run/current-system/sw/bin/waybar --config /home/charlie/.config/waybar/config.override --style /home/charlie/.config/waybar/style.override.css
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target