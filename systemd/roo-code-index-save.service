[Unit]
Description=Roo Code Index Save Backup Service
Documentation=https://roocodeapp.com/docs

After=qdrant.service

[Service]
Type=oneshot
User=charlie
Group=users

# 执行保存脚本
ExecStart=%h/.local/bin/roo-index-save.sh

# 日志输出
StandardOutput=journal
StandardError=journal
SyslogIdentifier=roo-index-save

# 超时设置（备份可能需要时间）
TimeoutStartSec=600s

[Install]
WantedBy=default.target
