[Unit]
Description=ttyd - Overcode Terminal (:7692)
After=network.target

[Service]
Type=simple
ExecStart=/run/current-system/sw/bin/ttyd -p 7692 -t fontSize=14 -t scrollback=50000 -t rendererType=canvas -W /home/charlie/.local/bin/overcode-tmux-wrap
Restart=on-failure
RestartSec=5
Environment=HOME=/home/charlie
Environment=PATH=/run/current-system/sw/bin:/home/charlie/.local/bin:/home/charlie/.nix-profile/bin
Environment=TERM=xterm-256color
Environment=COLORTERM=truecolor

[Install]
WantedBy=default.target
