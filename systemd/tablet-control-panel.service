[Unit]
Description=Tablet Control Panel API Server (port 9876)
After=network.target

OnFailure=sentinel-onfailure@tablet-control-panel.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=simple
ExecStartPre=-/bin/sh -c 'ss -tlnp | grep -q ":9876 " && echo "PORT 9876 IN USE" && exit 1 || true'
ExecStart=/run/current-system/sw/bin/python3 /home/charlie/launcher/tablet-control-api.py
WorkingDirectory=/home/charlie/launcher
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target


