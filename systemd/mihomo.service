[Unit]
Description=Mihomo Proxy Service
After=network.target

OnFailure=sentinel-onfailure@mihomo.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=simple
User=charlie
ExecStart=/run/current-system/sw/bin/mihomo -d %h/.config/mihomo -f %h/.config/mihomo/config.yaml
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target

