[Unit]
Description=AGI Control Plane Gateway (port 9900)
After=network.target

[Service]
WorkingDirectory=/mnt/ai/apps/agi-control-plane/backend
ExecStartPre=-/bin/sh -c 'ss -tlnp | grep -q ":9900 " && echo "PORT 9900 IN USE" && exit 1 || true'
ExecStart=/run/current-system/sw/bin/python -m uvicorn main:app --host 0.0.0.0 --port 9900
Restart=on-failure
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
RestartSec=10
Environment=PYTHONPATH=/mnt/ai/apps/agi-control-plane/backend

[Install]
WantedBy=default.target


