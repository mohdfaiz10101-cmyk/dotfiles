[Unit]
Description=Cookie Watcher — real-time sync of Floorp cookies
After=browser-cookie-sync.timer

[Service]
Type=simple
ExecStart=%h/.local/bin/cookie-watcher.py --daemon
OnFailure=sentinel-onfailure@cookie-watcher.service
Restart=on-failure
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
RestartSec=10

[Install]
WantedBy=default.target

