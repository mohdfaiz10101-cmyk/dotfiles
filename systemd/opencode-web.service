[Unit]
Description=OpenCode Web Server (:8080)
After=network.target

[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/opencode web --port 8080 --hostname 0.0.0.0
Restart=on-failure
RestartSec=5
Environment="HOME=/home/charlie" "PATH=/run/current-system/sw/bin:/home/charlie/.local/bin:/home/charlie/.nix-profile/bin" "OPENCODE_SERVER_PASSWORD=charlie2026"
PassEnvironment=OPENCODE_SERVER_PASSWORD

[Install]
WantedBy=default.target
