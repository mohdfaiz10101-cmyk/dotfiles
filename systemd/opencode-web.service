[Unit]
Description=OpenCode Web Server (:8080)
After=network.target

[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/opencode web --port 8080 --hostname 0.0.0.0
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=120
StartLimitBurst=5
MemoryMax=infinity
OOMScoreAdjust=-500
Environment="HOME=/home/charlie" "PATH=/run/current-system/sw/bin:/home/charlie/.local/bin:/home/charlie/.nix-profile/bin"

[Install]
WantedBy=default.target
