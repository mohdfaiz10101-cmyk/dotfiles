[Unit]
Description=Image Search API (CLIP)
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/ai/apps/image-search
ExecStart=/mnt/ai/apps/image-search/.venv/bin/python3 server.py
Restart=on-failure
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
RestartSec=10
Environment=HF_HOME=/home/charlie/.cache/huggingface

[Install]
WantedBy=default.target
