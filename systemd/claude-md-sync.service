[Unit]
Description=CLAUDE.md → AGENTS.md 实时同步监听
After=default.target

[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/claude-md-watcher.sh
OnFailure=sentinel-onfailure@claude-md-sync.service
Restart=on-failure
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
RestartSec=10
Environment=HOME=/home/charlie

[Install]
WantedBy=default.target

