[Unit]
Description=Overtab tmux session keeper (serve mode)
After=network.target

OnFailure=sentinel-onfailure@overtab-serve.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/home/charlie/.local/bin/overtab-serve-start
ExecStop=/home/charlie/.local/bin/overtab-serve-stop
Restart=on-failure
RestartSec=10
Environment=HOME=/home/charlie
Environment=PATH=/run/current-system/sw/bin:/home/charlie/.local/bin:/home/charlie/.nix-profile/bin
Environment=TERM=xterm-256color

[Install]
WantedBy=default.target
