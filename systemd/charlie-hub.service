[Unit]
Description=Charlie Hub (FastAPI :9800 静态+API)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/charlie/hub
ExecStartPre=-/bin/sh -c 'ss -tlnp | grep -q ":9800 " && echo "PORT 9800 IN USE" && exit 1 || true'
ExecStart=/run/current-system/sw/bin/python3 hub-api.py
Restart=on-failure
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
RestartSec=10
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=default.target


