[Unit]
Description=Memory Evolution Engine - Self-Evolving AI Memory System
After=network.target ollama.service letta.service
StartLimitBurst=3
StartLimitIntervalSec=3600

[Service]
EnvironmentFile=%h/dotfiles/systemd/service-common.env
Type=simple
ExecStart=/home/charlie/.local/bin/memory-evolution-engine
Restart=on-failure
RestartSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
