[Unit]
Description=AGI Brain Telegram Bot — Enhanced Conversational Assistant
After=network.target

OnFailure=sentinel-onfailure@agi-telegram-bot.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=simple
WorkingDirectory=/home/charlie/agi
ExecStartPre=-/bin/sh -c 'ss -tlnp | grep -q ":7890 " && echo "PORT 7890 IN USE" && exit 1 || true'
ExecStart=/home/charlie/agi/.venv/bin/python3 /home/charlie/agi/telegram_bot_enhanced.py --mode polling --proactive
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

Environment="TG_BOT_TOKEN=8797063873:AAGvApEP9frmA74b6nmxODHshzo1TwJR5ks"
Environment="TG_CHAT_ID=5036541266"
Environment="HTTPS_PROXY=http://127.0.0.1:7890"
Environment="HTTP_PROXY=http://127.0.0.1:7890"
Environment="https_proxy=http://127.0.0.1:7890"
Environment="http_proxy=http://127.0.0.1:7890"

[Install]
WantedBy=default.target


