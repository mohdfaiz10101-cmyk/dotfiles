[Unit]
Description=ttyd - OpenCode tmux serve (:8080)
After=network.target

[Service]
Type=simple
ExecStartPre=-/bin/sh -c 'fuser -k 8080/tcp 2>/dev/null; sleep 0.5; true'
ExecStart=/run/current-system/sw/bin/ttyd -P 3 -p 8080 -I /home/charlie/.local/share/ttyd-custom/index.html -t fontSize=10 -t disableLeaveAlert=true -t 'theme={"background":"#1a1a2e","foreground":"#e0e0e8"}' -t scrollback=50000 -W /home/charlie/.local/bin/openclaw-tmux-wrap
ExecStop=/bin/sh -c 'fuser -k 8080/tcp 2>/dev/null || true'
Restart=on-failure
RestartSec=10
MemoryHigh=1200M
MemoryMax=2G
Environment=HOME=/home/charlie
Environment=PATH=/run/current-system/sw/bin:/home/charlie/.local/bin:/home/charlie/.npm-global/bin:/home/charlie/.nix-profile/bin
Environment=OLLAMA_HOST=http://127.0.0.1:11434
Environment=TERM=xterm-256color
Environment=COLORTERM=truecolor
Environment=OPENCODE_EXPERIMENTAL_WORKSPACES=1

[Install]
WantedBy=default.target
