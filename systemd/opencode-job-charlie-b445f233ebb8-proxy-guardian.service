[Unit]
Description=OpenCode Job (adaptive): proxy-guardian

[Service]
Type=oneshot
WorkingDirectory=/home/charlie
Environment="PATH=/run/current-system/sw/bin:/home/charlie/.local/bin:/usr/bin:/bin"
ExecStart=/home/charlie/.local/bin/op-adaptive-gate proxy-guardian /run/current-system/sw/bin/perl /home/charlie/.config/opencode/scheduler/scopes/charlie-b445f233ebb8/jobs/proxy-guardian.json
StandardOutput=append:/home/charlie/.config/opencode/logs/scheduler/charlie-b445f233ebb8/proxy-guardian.log
StandardError=append:/home/charlie/.config/opencode/logs/scheduler/charlie-b445f233ebb8/proxy-guardian.log
TimeoutStartSec=600

[Install]
WantedBy=default.target
