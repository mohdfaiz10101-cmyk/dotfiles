[Unit]
Description=Claude ESP Server - 实时同步 Claude 操作到平板
After=network.target

OnFailure=sentinel-onfailure@claude-esp.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=simple
ExecStart=/run/current-system/sw/bin/python3 /home/charlie/launcher/claude-esp-simple.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target

