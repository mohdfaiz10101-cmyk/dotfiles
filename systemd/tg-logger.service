[Unit]
Description=Telegram Bot Message Logger
After=network-online.target

OnFailure=sentinel-onfailure@tg-logger.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
ExecStartPre=-/bin/sh -c 'ss -tlnp | grep -q ":7890 " && echo "PORT 7890 IN USE" && exit 1 || true'
ExecStart=/run/current-system/sw/bin/python3 /home/charlie/agi/tg_logger.py
Restart=always
RestartSec=10
Environment=HTTPS_PROXY=http://127.0.0.1:7890
Environment=https_proxy=http://127.0.0.1:7890

[Install]
WantedBy=default.target


