Environment=OPENCLAW_SERVICE_MANAGED_ENV_KEYS=OPENAI_API_KEY,OPENAI_BASE_URL
Environment=HOME=/home/charlie
Environment=TMPDIR=%h/.local/state/tmp
Environment=PATH=/nix/store/b7l2gabdzzp7cnizz14y99bw00hm67ky-nodejs-slim-22.22.2/bin:/home/charlie/.bun/bin:/home/charlie/.local/bin:/home/charlie/.npm-global/bin:/home/charlie/bin:/home/charlie/.local/share/flatpak/exports/bin:/var/lib/flatpak/exports/bin:/home/charlie/.nix-profile/bin:/nix/profile/bin:/home/charlie/.local/state/nix/profile/bin:/etc/profiles/per-user/charlie/bin:/nix/var/nix/profiles/default/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
Environment=OPENCLAW_GATEWAY_PORT=18789
Environment=OPENCLAW_SYSTEMD_UNIT=openclaw-gateway.service
Environment="OPENCLAW_WINDOWS_TASK_NAME=OpenClaw Gateway"
Environment=OPENCLAW_SERVICE_MARKER=openclaw
Environment=OPENCLAW_SERVICE_KIND=gateway
Environment=OPENCLAW_SERVICE_VERSION=2026.5.7

[Install]
WantedBy=default.target
