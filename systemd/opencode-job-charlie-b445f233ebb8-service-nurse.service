[Unit]
Description=OpenCode Job (adaptive): service-nurse

[Service]
Type=oneshot
WorkingDirectory=/home/charlie
Environment="PATH=/run/current-system/sw/bin:/home/charlie/.local/bin:/usr/bin:/bin"
ExecStart=/home/charlie/.local/bin/op-adaptive-gate service-nurse /run/current-system/sw/bin/perl /home/charlie/.config/opencode/scheduler/scopes/charlie-b445f233ebb8/jobs/service-nurse.json
StandardOutput=append:/home/charlie/.config/opencode/logs/scheduler/charlie-b445f233ebb8/service-nurse.log
StandardError=append:/home/charlie/.config/opencode/logs/scheduler/charlie-b445f233ebb8/service-nurse.log
TimeoutStartSec=600

[Install]
WantedBy=default.target
