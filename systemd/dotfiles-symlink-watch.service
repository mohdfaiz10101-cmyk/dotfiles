[Unit]
Description=监控 dotfiles/opencode 循环链接，实时修复
After=default.target

OnFailure=sentinel-onfailure@dotfiles-symlink-watch.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/dotfiles-symlink-watch.sh
Restart=always
RestartSec=10

[Install]
WantedBy=default.target

