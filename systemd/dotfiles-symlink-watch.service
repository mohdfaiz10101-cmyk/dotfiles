[Unit]
Description=监控 dotfiles/opencode 循环链接，实时修复
After=default.target

[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/dotfiles-symlink-watch.sh
OnFailure=sentinel-onfailure@dotfiles-symlink-watch.service
Restart=always
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
RestartSec=10

[Install]
WantedBy=default.target

