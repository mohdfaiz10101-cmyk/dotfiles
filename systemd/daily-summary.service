[Unit]
Description=Daily WeChat + Telegram Summary
After=network-online.target

[Service]
Type=oneshot
ExecStart=/run/current-system/sw/bin/python3 /home/charlie/agi/daily_summary.py
Environment=HTTPS_PROXY=http://127.0.0.1:7890
Environment=https_proxy=http://127.0.0.1:7890
StandardOutput=journal
StandardError=journal
