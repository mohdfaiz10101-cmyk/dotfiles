[Unit]
Description=HQSSH Daemon - AI CLI Session Manager
Documentation=https://github.com/Gelotto/hqsshd
After=network.target

[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/hqsshd -socket %t/hqssh.sock
ExecStartPost=/bin/sh -c 'ln -sf %t/hqssh.sock /tmp/hqssh.sock'
ExecStopPost=/bin/sh -c 'rm -f /tmp/hqssh.sock'
Restart=on-failure
RestartSec=5
Environment=HOME=%h
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/run/current-system/sw/bin:/usr/bin:/bin

# Logging goes to journald
# View with: journalctl --user -u hqsshd -f
StandardOutput=journal
StandardError=journal

# Security hardening
# NOTE: ProtectHome is intentionally omitted — AI tools (claude, codex, aider)
# need write access to project directories under $HOME.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=default.target
