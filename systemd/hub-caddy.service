[Unit]
Description=Charlie Hub Caddy Reverse Proxy (:9800)
After=charlie-hub.service

[Service]
Type=simple
ExecStartPre=-/bin/sh -c 'ss -tlnp | grep -q ":9800 " && echo "PORT 9800 IN USE" && exit 1 || true'
ExecStart=/nix/store/2s1j11arfkc11qr2w8mkb8k5mjqlg4k3-caddy-2.10.2/bin/caddy run --config /home/charlie/hub/Caddyfile
Restart=on-failure
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
RestartSec=10
Environment=XDG_DATA_HOME=/home/charlie/.local/share
Environment=XDG_CONFIG_HOME=/home/charlie/.config

[Install]
WantedBy=default.target


