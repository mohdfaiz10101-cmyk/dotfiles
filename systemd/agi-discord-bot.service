[Unit]
Description=AGI Brain Discord Bot — Enhanced Conversational Assistant
After=network.target agi-brain.service
Requires=agi-brain.service

[Service]
Type=simple
WorkingDirectory=/home/charlie/agi
ExecStart=/home/charlie/agi/.venv/bin/python3 /home/charlie/agi/discord_bot_enhanced.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment="PYTHONUNBUFFERED=1"
Environment="DISCORD_BOT_TOKEN=MTQ5MDY0MTY3ODEzNzAzMjg0NA.G7dnjb.8XnDoykFr9O8SRsQH1nnCXiV0Ge2LEOGTI47f8"
Environment="DISCORD_GUILD_ID=1490683033919950941"

[Install]
WantedBy=default.target
