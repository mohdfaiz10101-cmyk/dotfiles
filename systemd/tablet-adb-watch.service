[Unit]
Description=Auto-reconnect ADB to Xiaomi Pad 5 via Tailscale
After=network-online.target tailscaled.service

[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/tablet-adb-watch
OnFailure=sentinel-onfailure@tablet-adb-watch.service
Restart=always
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
RestartSec=10
Environment=HOME=/home/charlie
Environment=PATH=/home/charlie/.local/bin:/run/current-system/sw/bin:/usr/bin:/bin

[Install]
WantedBy=default.target

