[Unit]
Description=OpenCode Job: glm-knowledge-writer

[Service]
Type=oneshot
WorkingDirectory=/home/charlie
Environment="PATH=/run/current-system/sw/bin:/home/charlie/.local/bin:/usr/bin:/bin"
ExecStart=/home/charlie/.local/bin/op-adaptive-gate glm-knowledge-writer /run/current-system/sw/bin/perl /home/charlie/.config/opencode/scheduler/scopes/charlie-b445f233ebb8/jobs/glm-knowledge-writer.json
StandardOutput=append:/home/charlie/.config/opencode/logs/scheduler/charlie-b445f233ebb8/glm-knowledge-writer.log
StandardError=append:/home/charlie/.config/opencode/logs/scheduler/charlie-b445f233ebb8/glm-knowledge-writer.log
TimeoutStartSec=600

[Install]
WantedBy=default.target
