[Unit]
Description=自动验证（防抖5秒）— 前端pipeline + 后端syntax
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/run/current-system/sw/bin/sleep 5
ExecStart=/home/charlie/.local/bin/verify-pipeline.sh --project /mnt/ai/apps/agi-control-plane/frontend --agent auto-watchdog
ExecStart=/home/charlie/.local/bin/post-edit-verify.sh --auto
StandardOutput=journal
StandardError=journal