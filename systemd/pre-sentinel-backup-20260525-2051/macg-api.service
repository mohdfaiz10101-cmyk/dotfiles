[Unit]
Description=MACG API — OpenAI 兼容包装层 (port 9910)
After=network.target litellm.service
Wants=default.target

[Service]
Type=simple
ExecStartPre=-/bin/sh -c 'ss -tlnp | grep -q ":9910 " && echo "PORT 9910 IN USE" && exit 1 || true'
ExecStart=/run/current-system/sw/bin/python /home/charlie/agi/macg_api.py
WorkingDirectory=/home/charlie/agi
Restart=on-failure
StartLimitIntervalSec=60
StartLimitAction=none
RestartSec=15
StartLimitBurst=5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/charlie/agi
Environment=HOME=/home/charlie
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY http_proxy https_proxy
Environment=NO_PROXY=localhost,127.0.0.1
Environment=no_proxy=localhost,127.0.0.1
Environment=ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# SOPS 解密：key 从 /run/secrets/zai-api-key 读取（nixos-rebuild 后生效）
EnvironmentFile=-/run/secrets/zai-api-key-env
Environment=ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-4.5-air
Environment=ANTHROPIC_DEFAULT_SONNET_MODEL=glm-5.1
Environment=ANTHROPIC_DEFAULT_OPUS_MODEL=glm-5.1

[Install]
WantedBy=default.target


