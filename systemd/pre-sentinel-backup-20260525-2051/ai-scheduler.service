[Unit]
Description=AI 智能调度器
After=network.target

[Service]
Type=oneshot
Environment=PATH=/run/current-system/sw/bin:/home/charlie/.local/bin:/usr/bin:/bin
ExecStart=/run/current-system/sw/bin/bash /home/charlie/.local/bin/ai-scheduler.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
