[Unit]
Description=记忆清理 — 归档过期条目、轮转日志、压缩归档
After=network.target

[Service]
Type=oneshot
ExecStart=/home/charlie/.local/bin/memory-cron.sh daily
StandardOutput=journal
StandardError=journal
Environment=HOME=/home/charlie
Environment=PATH=/run/current-system/sw/bin:/home/charlie/.local/bin

[Install]
WantedBy=default.target
