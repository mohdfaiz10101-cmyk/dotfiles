[Unit]
Description=DuckDNS DDNS Update
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.local/share/credentials/duckdns.env
ExecStart=/bin/sh -c 'curl -4 -sL --noproxy "*" --retry 3 --retry-delay 5 --connect-timeout 10 "https://www.duckdns.org/update?domains=${DUCKDNS_DOMAIN}&token=${DUCKDNS_TOKEN}&ip=" -o %h/.local/state/duckdns/last-update'