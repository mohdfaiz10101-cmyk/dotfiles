[Unit]
Description=ttyd terminal on port 8080 with custom session switcher
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=20

[Service]
Type=simple
ExecStartPre=-/bin/sh -c 'ss -tlnp | grep -q ":8080 " && echo "PORT 8080 IN USE" && exit 1 || true'
ExecStart=/bin/sh -c 'exec /run/current-system/sw/bin/strace -f --trace=signal --signal=SIGTERM -o /home/charlie/.local/state/ttyd-debug/strace-$$(date +%%Y%%m%%d-%%H%%M%%S).log /run/current-system/sw/bin/ttyd -p 8080 -P 10 -t fontSize=13 -t disableLeaveAlert=true -t scrollback=50000 -I /home/charlie/.local/share/ttyd-custom/index.html -W /home/charlie/.local/bin/openclaw-tmux-wrap'
OnFailure=sentinel-onfailure@ttyd-8080.service
Restart=always
RestartSec=3
ExecStopPost=-/bin/sh -c 'mkdir -p ~/.local/state/ttyd-debug 2>/dev/null; echo "[$(date -Iseconds)] ttyd-8080 stopping, dumping context" >> ~/.local/state/ttyd-debug/stop-trace.log; ps -eo ppid,pid,comm --forest --no-headers | head -50 >> ~/.local/state/ttyd-debug/stop-trace.log 2>&1; journalctl --user --since "10 seconds ago" -o cat --no-pager 2>/dev/null | grep -v ttyd | head -20 >> ~/.local/state/ttyd-debug/stop-trace.log 2>&1; echo "---" >> ~/.local/state/ttyd-debug/stop-trace.log'

[Install]
WantedBy=default.target

