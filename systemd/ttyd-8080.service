[Unit]
Description=ttyd terminal on port 8080 with custom session switcher
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=20

OnFailure=sentinel-onfailure@ttyd-8080.service
[Service]
Type=simple
ExecStartPre=-/bin/sh -c 'fuser -k 8080/tcp 2>/dev/null; sleep 0.5; true'
ExecStart=/run/current-system/sw/bin/ttyd -p 8080 -P 10 -t fontSize=13 -t disableLeaveAlert=true -t scrollback=50000 -I /home/charlie/.local/share/ttyd-custom/index.html -W /home/charlie/.local/bin/openclaw-tmux-wrap
Restart=always
RestartSec=3
ExecStopPost=-/bin/sh -c 'mkdir -p ~/.local/state/ttyd-debug 2>/dev/null; echo "[$(date -Iseconds)] ttyd-8080 stopping, dumping context" >> ~/.local/state/ttyd-debug/stop-trace.log; ps -eo ppid,pid,comm --forest --no-headers | head -50 >> ~/.local/state/ttyd-debug/stop-trace.log 2>&1; journalctl --user --since "10 seconds ago" -o cat --no-pager 2>/dev/null | grep -v ttyd | head -20 >> ~/.local/state/ttyd-debug/stop-trace.log 2>&1; echo "---" >> ~/.local/state/ttyd-debug/stop-trace.log'

[Install]
WantedBy=default.target

