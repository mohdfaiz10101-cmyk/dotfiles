[Unit]
Description=DeerFlow LangGraph Server (port 2024)
After=network.target ollama.service

[Service]
Type=simple
WorkingDirectory=/mnt/ai/ai-cluster/deerflow/backend
ExecStart=/mnt/ai/ai-cluster/deerflow/backend/.venv/bin/langgraph dev --no-browser --allow-blocking --no-reload --host 0.0.0.0 --port 2024 --n-jobs-per-worker 10
Restart=on-failure
RestartSec=10
Environment=DEER_FLOW_CONFIG_PATH=/mnt/ai/ai-cluster/deerflow/config.yaml

[Install]
WantedBy=default.target
