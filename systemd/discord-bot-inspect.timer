[Unit]
Description=Run Discord Bot Inspection Every 30 Minutes (08:00-23:00)

[Timer]
OnCalendar=hourly
OnCalendar=*-*-* 08,08:30,09,09:30,10,10:30,11,11:30,12,12:30,13,13:30,14,14:30,15,15:30,16,16:30,17,17:30,18,18:30,19,19:30,20,20:30,21,21:30,22,22:30,23:00
Persistent=true
Unit=discord-bot-inspect.service

[Install]
WantedBy=timers.target
