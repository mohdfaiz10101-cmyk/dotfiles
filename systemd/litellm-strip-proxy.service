[Unit]
Description=LiteLLM Tool-Stripping Proxy
After=docker.service
Wants=docker.service

OnFailure=sentinel-onfailure@litellm-strip-proxy.service
StartLimitAction=none
StartLimitBurst=5
StartLimitIntervalSec=30
[Service]
Type=simple
ExecStart=/run/current-system/sw/bin/python3 /mnt/ai-cluster/litellm/strip_tools_proxy.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target

