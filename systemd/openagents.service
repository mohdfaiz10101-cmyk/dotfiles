[Unit]
Description=OpenAgents Network Daemon
After=network-online.target openclaw-gateway.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/charlie/.local/bin/openagents up
Restart=always
RestartSec=5
Environment=HOME=/home/charlie
Environment=PATH=/home/charlie/.local/bin:/run/current-system/sw/bin
Environment=OPENAGENTS_PORT=8700

[Install]
WantedBy=default.target
