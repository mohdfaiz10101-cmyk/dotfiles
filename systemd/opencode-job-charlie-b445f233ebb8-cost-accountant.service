[Unit]
Description=OpenCode Job: cost-accountant

[Service]
Type=oneshot
WorkingDirectory=/home/charlie
Environment="PATH=/run/current-system/sw/bin:/home/charlie/.npm-global/bin:/home/charlie/.local/bin:/usr/bin:/bin"
ExecStart="/run/current-system/sw/bin/perl" "/home/charlie/.config/opencode/scheduler/supervisor.pl" "/home/charlie/.config/opencode/scheduler/scopes/charlie-b445f233ebb8/jobs/cost-accountant.json"
StandardOutput=append:/home/charlie/.config/opencode/logs/scheduler/charlie-b445f233ebb8/cost-accountant.log
StandardError=append:/home/charlie/.config/opencode/logs/scheduler/charlie-b445f233ebb8/cost-accountant.log

[Install]
WantedBy=default.target
