[Unit]
Description=WeChat Sync Daemon — auto-sync messages every 60s
After=network.target

OnFailure=sentinel-onfailure@wechat-sync.service
StartLimitAction=none
StartLimitBurst=3
StartLimitIntervalSec=3600
[Service]
Type=simple
WorkingDirectory=/mnt/ai/ai-cluster/wechat-sync
ExecStart=/run/current-system/sw/bin/nix-shell -p python313Packages.httpx sqlcipher python313Packages.zstandard --run "python3 sync_daemon.py"
Restart=on-failure
RestartSec=300
Environment=HOME=/home/charlie

[Install]
WantedBy=default.target

