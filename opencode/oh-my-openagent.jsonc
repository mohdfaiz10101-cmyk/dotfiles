{
  "$schema": "https://opencode.ai/opencode.json",
  "version": "3.17.2",
  "disable_telemetry": true,
  "agents": {
    "sisyphus": {
      "description": "主编排器 — 任务分解、委派子 agent、验证结果闭环",
      "model": "openai-compatible/glm-5.1",
      "temperature": 0.1,
      "fallback_models": [
        "openai-compatible/deepseek-v4-pro",
        "openai-compatible/glm-5-turbo"
      ],
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "librarian": "allow",
          "oracle": "allow",
          "metis": "allow",
          "momus": "allow",
          "general": "allow"
        }
      },
      "prompt_append": "MUST 始终使用中文回复，输出≤20行，格式 [OK/FAIL/WARN] 操作→结果。\nFALSE_POSITIVE_GUARD：systemctl is-active返回inactive≠失败，用 show --property=Result 验证。\nAGENTS.md 仅 CC 写入，需改规则输出 CC_DELEGATE:新增规则到AGENTS.md:{内容}。\nCC_REVIEW：完成任务后 cd ~/dotfiles && git log cc ^main --oneline | head -3，有新提交则 diff main..cc --stat 输出评论。"
    },
    "atlas": {
      "description": "大师编排器 — 多 agent 并行协调，Plan 执行引擎",
      "model": "openai-compatible/glm-5-turbo",
      "temperature": 0.1,
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "librarian": "allow",
          "general": "allow"
        }
      },
      "prompt_append": "MUST 始终使用中文回复，输出≤20行，格式 [OK/FAIL/WARN] 操作→结果。",
      "fallback_models": [
        "openai-compatible/deepseek-v4-pro",
        "openai-compatible/glm-5-turbo"
      ]
    },
    "prometheus": {
      "description": "规划器 — 分析需求、生成可执行计划（Plan Mode）",
      "model": "openai-compatible/glm-5.1",
      "temperature": 0.3,
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "librarian": "allow",
          "general": "allow"
        }
      },
      "prompt_append": "MUST 始终使用中文回复，输出≤20行，格式 [OK/FAIL/WARN] 操作→结果。",
      "fallback_models": [
        "openai-compatible/deepseek-v4-pro",
        "openai-compatible/glm-5-turbo"
      ]
    },
    "hephaestus": {
      "description": "深度执行器 — 长上下文代码生成、复杂重构",
      "model": "openai-compatible/deepseek-v4-pro",
      "temperature": 0.2,
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "librarian": "allow",
          "general": "allow"
        }
      },
      "prompt_append": "MUST 始终使用中文回复，输出≤20行，格式 [OK/FAIL/WARN] 操作→结果。\n编码规则：改前先 read_file 读完整内容，改后重启→curl→日志→前端验证。\n3000控制台 HMR 自动生效，禁止 bun run build。\nFALSE_POSITIVE_GUARD：systemctl is-active 返回 inactive≠失败，用 show --property=Result 验证。",
      "fallback_models": [
        "openai-compatible/deepseek-v4-pro",
        "openai-compatible/glm-5-turbo"
      ]
    },
    "oracle": {
      "description": "只读顾问 — 架构决策、疑难 bug 诊断（GPT-4.1，Claude key 暂缺）",
      "model": "openai-compatible/gpt-4.1",
      "temperature": 0.2,
      "prompt_append": "MUST 始终使用中文回复，输出≤20行，格式 [OK/FAIL/WARN] 操作→结果。",
      "fallback_models": [
        "openai-compatible/deepseek-v4-pro",
        "openai-compatible/glm-5-turbo"
      ]
    },
    "librarian": {
      "description": "文档研究员 — 多仓库分析、官方文档检索",
      "model": "openai-compatible/glm-5-turbo",
      "temperature": 0.1,
      "prompt_append": "MUST 始终使用中文回复，输出≤20行，格式 [OK/FAIL/WARN] 操作→结果。",
      "fallback_models": [
        "openai-compatible/deepseek-v4-pro",
        "openai-compatible/glm-5-turbo"
      ]
    },
    "explore": {
      "description": "代码搜索员 — 定位文件、函数、实现模式",
      "model": "openai-compatible/deepseek-v4-flash",
      "temperature": 0.1,
      "prompt_append": "MUST 始终使用中文回复，输出≤20行，格式 [OK/FAIL/WARN] 操作→结果。",
      "fallback_models": [
        "openai-compatible/deepseek-v4-pro",
        "openai-compatible/glm-5-turbo"
      ]
    },
    "web-chat": {
      "description": "🌐 Web AI 免费聊天 — 自动选最快可用网页AI",
      "model": "web-ai/auto",
      "temperature": 0.3,
      "prompt_append": "你正在使用免费的网页版AI工具。回复中不要提及你是使用网页版工具。直接回答用户问题。"
    },
    "web-deepseek": {
      "description": "DeepSeek Chat (web免费版) — 适合代码/技术问题",
      "model": "web-ai/deepseek-chat",
      "temperature": 0.3,
      "prompt_append": "直接回答用户问题，不要提及你是网页版。"
    },
    "web-merged": {
      "description": "📊 Web AI 综合 — 同时查全部网页AI工具",
      "model": "web-ai/merged",
      "temperature": 0.3,
      "prompt_append": "直接回答用户问题。"
    },
    "web-merged-smart": {
      "description": "🧠 Web AI 综合(GLM合成) — 查全部后用GLM智能汇总",
      "model": "web-ai/merged-smart",
      "temperature": 0.3,
      "prompt_append": "直接回答用户问题。"
    },
    "metis": {
      "description": "预规划顾问 — 识别隐含意图、歧义、AI 失败模式",
      "model": "openai-compatible/glm-5-turbo",
      "temperature": 0.2,
      "prompt_append": "MUST 始终使用中文回复，输出≤20行，格式 [OK/FAIL/WARN] 操作→结果。",
      "fallback_models": [
        "openai-compatible/deepseek-v4-pro",
        "openai-compatible/glm-5-turbo"
      ]
    },
    "momus": {
      "description": "评审员 — 代码审查（Qwen3-235B）",
      "model": "openai-compatible/qwen3-235b",
      "temperature": 0.3,
      "prompt_append": "MUST 始终使用中文回复，输出≤20行，格式 [OK/FAIL/WARN] 操作→结果。",
      "fallback_models": [
        "openai-compatible/deepseek-v4-pro",
        "openai-compatible/glm-5-turbo"
      ]
    },
    "multimodal-looker": {
      "description": "媒体分析员 — PDF/图片/图表深度解读",
      "model": "openai-compatible/glm-4.6v-flash",
      "temperature": 0.1,
      "prompt_append": "MUST 始终使用中文回复，输出≤20行，格式 [OK/FAIL/WARN] 操作→结果。",
      "fallback_models": [
        "openai-compatible/deepseek-v4-pro",
        "openai-compatible/glm-5-turbo"
      ]
    }
  },
  "category_mapping": {
    "quick": "openai-compatible/deepseek-v4-flash",
    "unspecified-low": "openai-compatible/glm-5-turbo",
    "unspecified-high": "openai-compatible/glm-5.1",
    "deep": "openai-compatible/gpt-4.1",
    "visual-engineering": "openai-compatible/glm-5.1",
    "ultrabrain": "openai-compatible/deepseek-v4-pro",
    "writing": "openai-compatible/glm-5-turbo",
    "artistry": "openai-compatible/qwen3-235b"
  },
  "background": {
    "max_concurrent": 3,
    "provider_limits": {
      "openai-compatible": {
        "max_parallel": 2
      }
    }
  },
  "lsp": {
    "enabled": true,
    "auto_start": true,
    "servers": {
      "typescript": {
        "command": "typescript-language-server",
        "args": [
          "--stdio"
        ]
      },
      "bash": {
        "command": "bash-language-server",
        "args": [
          "start"
        ]
      },
      "python": {
        "command": "pylsp"
      },
      "json": {
        "command": "vscode-json-language-server",
        "args": [
          "--stdio"
        ]
      },
      "yaml": {
        "command": "yaml-language-server",
        "args": [
          "--stdio"
        ]
      }
    }
  },
  "mcp": {
    "exa": {
      "enabled": true,
      "api_key": "${OMC_EXA_API_KEY:-}",
      "endpoint": "https://api.exa.ai"
    },
    "context7": {
      "enabled": true,
      "api_key": "ctx7sk-079b5643-e8e2-4eec-8b30-f0602f9e8d3c"
    },
    "grep_app": {
      "enabled": true
    }
  },
  "hashline": {
    "enabled": true,
    "strict": true
  },
  "hooks": {
    "disabled": [
      "experimental.session.compacting"
    ]
  },
  "comment_checker": {
    "enabled": true,
    "strict": false
  },
  "todo_enforcer": {
    "enabled": true,
    "timeout_seconds": 300
  },
  "ralph_loop": {
    "enabled": true,
    "max_iterations": 10
  },
  "experimental": {
    "preemptive_compaction": true
  },
  "disabled_mcps": [],
  "env": {
    "OMO_SEND_ANONYMOUS_TELEMETRY": "0",
    "OMO_DISABLE_POSTHOG": "1"
  }
}
