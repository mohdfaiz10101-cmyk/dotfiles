{
  "$schema": "https://opencode.ai/opencode.json",
  "version": "3.17.2",
  "disable_telemetry": true,
  "agents": {
    "sisyphus": {
      "description": "主编排器 — 任务分解、委派子 agent、验证结果闭环",
      "model": "openai-compatible/glm-5.1",
      "temperature": 0.1,
      "fallback_models": [
        "openai-compatible/glm-5-turbo",
        "openai-compatible/glm-4-plus"
      ],
      "prompt_append": "FALSE_POSITIVE_GUARD（死规则）：systemctl --user is-active返回inactive≠失败。判断唯一方法：systemctl --user show <svc> --property=Result,ActiveState。Result=success→正常完成，禁止写[!]或升级CC。AGENTS.md只能CC写入，需改规则时输出CC_DELEGATE:新增规则到AGENTS.md:{内容}。MUST 始终使用中文回复用户，所有对话、解释、报告均用中文。代码注释可用英文。输出规则：总输出≤20行；格式 [OK/FAIL/WARN] 操作→结果；多项相同→×N合并；详细内容写文件只返回路径；无法处理时在末行写 CC_DELEGATE:任务描述 触发交接。会话启动时MUST检查CC委托任务：运行 grep '^- \\[ \\]' ~/.claude/projects/-home-charlie/memory/op-tasks.md，有未完成任务则立即执行，完成后用 sed -i 将对应行 '- [ ]' 改为 '- [x]'。CC_REVIEW规则：完成任务后运行 cd ~/dotfiles && git log cc ^main --oneline 2>/dev/null | head -3，有新提交时读取 git diff main..cc --stat 和前50行diff，输出≤5行中文评论 [OK/WARN/FAIL]，格式：[CC-review] 文件: 评论。 示例(正确): 巡检发现is-active返回inactive → 先运行show --property=Result → Result=success → 输出[SKIP]正常完成。示例(错误): 看到inactive直接写[!]失败。"
    },
    "atlas": {
      "description": "大师编排器 — 多 agent 并行协调，Plan 执行引擎",
      "model": "openai-compatible/glm-5-turbo",
      "temperature": 0.1,
      "prompt_append": "MUST 始终使用中文回复用户，所有对话、解释、报告均用中文。代码注释可用英文。输出规则：总输出≤20行；格式 [OK/FAIL/WARN] 操作→结果；多项相同→×N合并；详细内容写文件只返回路径；无法处理时在末行写 CC_DELEGATE:任务描述 触发交接。"
    },
    "prometheus": {
      "description": "规划器 — 分析需求、生成可执行计划（Plan Mode）",
      "model": "openai-compatible/glm-5.1",
      "temperature": 0.3,
      "prompt_append": "MUST 始终使用中文回复用户，所有对话、解释、报告均用中文。代码注释可用英文。输出规则：总输出≤20行；格式 [OK/FAIL/WARN] 操作→结果；多项相同→×N合并；详细内容写文件只返回路径；无法处理时在末行写 CC_DELEGATE:任务描述 触发交接。"
    },
    "hephaestus": {
      "description": "深度执行器 — 长上下文代码生成、复杂重构",
      "model": "openai-compatible/glm-5.1",
      "temperature": 0.2,
      "prompt_append": "编码死规则：(1) 修改任何代码文件前 MUST 先用 read_file 工具读取完整内容，禁止凭记忆猜测结构 (2) 修改后 MUST 重启服务→curl验证→检查日志→确认前端生效，不验证=任务未完成 (3) 3000控制台(/mnt/ai/apps/agi-control-plane/frontend/app/)已是dev模式(HMR)，改完自动生效，禁止执行bun run build (4) FALSE_POSITIVE_GUARD：systemctl is-active返回inactive≠失败，必须用 systemctl --user show <svc> --property=Result 验证，Result=success才是正常完成。MUST 始终使用中文回复用户，所有对话、解释、报告均用中文。代码注释可用英文。输出规则：总输出≤20行；格式 [OK/FAIL/WARN] 操作→结果；多项相同→×N合并；详细内容写文件只返回路径；无法处理时在末行写 CC_DELEGATE:任务描述 触发交接。 示例(正确): 用户说改route.ts → 先read_file读取完整内容 → 找到目标行 → edit_file精确替换 → curl验证。示例(错误): 不读文件直接猜测内容写入 → 必出错。"
    },
    "oracle": {
      "description": "只读顾问 — 架构决策、疑难 bug 诊断（GPT-4.1）",
      "model": "openai-compatible/gpt-4.1",
      "temperature": 0.2,
      "prompt_append": "MUST 始终使用中文回复用户，所有对话、解释、报告均用中文。代码注释可用英文。输出规则：总输出≤20行；格式 [OK/FAIL/WARN] 操作→结果；多项相同→×N合并；详细内容写文件只返回路径；无法处理时在末行写 CC_DELEGATE:任务描述 触发交接。"
    },
    "librarian": {
      "description": "文档研究员 — 多仓库分析、官方文档检索",
      "model": "openai-compatible/glm-5-turbo",
      "temperature": 0.1,
      "prompt_append": "MUST 始终使用中文回复用户，所有对话、解释、报告均用中文。代码注释可用英文。输出规则：总输出≤20行；格式 [OK/FAIL/WARN] 操作→结果；多项相同→×N合并；详细内容写文件只返回路径；无法处理时在末行写 CC_DELEGATE:任务描述 触发交接。"
    },
    "explore": {
      "description": "代码搜索员 — 定位文件、函数、实现模式",
      "model": "openai-compatible/glm-5-turbo",
      "temperature": 0.1,
      "prompt_append": "MUST 始终使用中文回复用户，所有对话、解释、报告均用中文。代码注释可用英文。输出规则：总输出≤20行；格式 [OK/FAIL/WARN] 操作→结果；多项相同→×N合并；详细内容写文件只返回路径；无法处理时在末行写 CC_DELEGATE:任务描述 触发交接。"
    },
    "metis": {
      "description": "预规划顾问 — 识别隐含意图、歧义、AI 失败模式",
      "model": "openai-compatible/glm-5-turbo",
      "temperature": 0.2,
      "prompt_append": "MUST 始终使用中文回复用户，所有对话、解释、报告均用中文。代码注释可用英文。输出规则：总输出≤20行；格式 [OK/FAIL/WARN] 操作→结果；多项相同→×N合并；详细内容写文件只返回路径；无法处理时在末行写 CC_DELEGATE:任务描述 触发交接。"
    },
    "momus": {
      "description": "评审员 — 代码审查（Qwen3-235B）",
      "model": "openai-compatible/qwen3-235b",
      "temperature": 0.3,
      "prompt_append": "MUST 始终使用中文回复用户，所有对话、解释、报告均用中文。代码注释可用英文。输出规则：总输出≤20行；格式 [OK/FAIL/WARN] 操作→结果；多项相同→×N合并；详细内容写文件只返回路径；无法处理时在末行写 CC_DELEGATE:任务描述 触发交接。"
    },
    "multimodal-looker": {
      "description": "媒体分析员 — PDF/图片/图表深度解读",
      "model": "openai-compatible/glm-4v-flash",
      "temperature": 0.1,
      "prompt_append": "MUST 始终使用中文回复用户，所有对话、解释、报告均用中文。代码注释可用英文。输出规则：总输出≤20行；格式 [OK/FAIL/WARN] 操作→结果；多项相同→×N合并；详细内容写文件只返回路径；无法处理时在末行写 CC_DELEGATE:任务描述 触发交接。"
    }
  },
  "category_mapping": {
    "quick": "openai-compatible/cerebras-llama-8b",
    "unspecified-low": "openai-compatible/glm-5-turbo",
    "unspecified-high": "openai-compatible/glm-5.1",
    "deep": "openai-compatible/gpt-4.1",
    "visual-engineering": "openai-compatible/glm-5.1",
    "ultrabrain": "openai-compatible/glm-5.1",
    "writing": "openai-compatible/glm-5-turbo",
    "artistry": "openai-compatible/qwen3-235b"
  },
  "background": {
    "max_concurrent": 3,
    "provider_limits": {
      "openai-compatible": {
        "max_parallel": 2
      }
    }
  },
  "lsp": {
    "enabled": true,
    "auto_start": true,
    "servers": {
      "typescript": {
        "command": "typescript-language-server",
        "args": [
          "--stdio"
        ]
      },
      "bash": {
        "command": "bash-language-server",
        "args": [
          "start"
        ]
      },
      "python": {
        "command": "pylsp"
      },
      "json": {
        "command": "vscode-json-language-server",
        "args": [
          "--stdio"
        ]
      },
      "yaml": {
        "command": "yaml-language-server",
        "args": [
          "--stdio"
        ]
      }
    }
  },
  "mcp": {
    "exa": {
      "enabled": true,
      "api_key": "${OMC_EXA_API_KEY:-}",
      "endpoint": "https://api.exa.ai"
    },
    "context7": {
      "enabled": true,
      "api_key": "ctx7sk-079b5643-e8e2-4eec-8b30-f0602f9e8d3c"
    },
    "grep_app": {
      "enabled": true
    }
  },
  "hashline": {
    "enabled": true,
    "strict": true
  },
  "hooks": {
    "disabled": [
      "experimental.session.compacting"
    ]
  },
  "comment_checker": {
    "enabled": true,
    "strict": false
  },
  "todo_enforcer": {
    "enabled": true,
    "timeout_seconds": 300
  },
  "ralph_loop": {
    "enabled": true,
    "max_iterations": 10
  },
  "experimental": {
    "preemptive_compaction": true
  },
  "disabled_mcps": [],
  "env": {
    "OMO_SEND_ANONYMOUS_TELEMETRY": "0",
    "OMO_DISABLE_POSTHOG": "1"
  }
}