{
  "$schema": "https://opencode.ai/opencode.json",
  "provider": {
    "openai-compatible": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "sk-litellm-charlie-2026"
      },
      "models": {
        "deepseek-v3.2": {
          "name": "DeepSeek V3.2 (SiliconFlow)",
          "limit": {
            "context": 163840,
            "output": 8192
          }
        },
        "glm-5.1": {
          "name": "GLM-5.1 旗舰 (Z.AI)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm-5-turbo": {
          "name": "GLM-5-Turbo (Z.AI)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm-4.7": {
          "name": "GLM-4.7 (Z.AI)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm-4-plus": {
          "name": "GLM-4-Plus (Z.AI)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "gpt-4.1": {
          "name": "GPT-4.1 (GitHub 免费)",
          "limit": {
            "context": 1047576,
            "output": 32768
          }
        },
        "qwen3-235b": {
          "name": "Qwen3-235B (SiliconFlow 免费)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "openai-compatible/glm-5-turbo",
  "small_model": "openai-compatible/glm-4.7",
  "default_agent": "sisyphus",
  "agent": {
    "build": {
      "model": "openai-compatible/glm-5.1",
      "prompt_append": "## 语言规则\nMUST 始终使用中文回复用户，所有对话、解释、报告均用中文。",
      "description": "代码构建器 — 代码生成、功能实现、测试编写"
    },
    "plan": {
      "model": "openai-compatible/glm-5.1",
      "prompt_append": "## 语言规则\nMUST 始终使用中文回复用户，所有对话、解释、报告均用中文。",
      "description": "规划器 — 分析需求、生成可执行计划（Plan Mode）"
    },
    "explore": {
      "model": "openai-compatible/glm-4.7",
      "prompt_append": "## 语言规则\nMUST 始终使用中文回复用户，所有对话、解释、报告均用中文。代码注释可用英文，但面向用户的输出必须中文。",
      "description": "代码搜索员 — 定位文件、函数、实现模式"
    },
    "chat": {
      "model": "openai-compatible/qwen3-235b",
      "prompt_append": "## 语言规则\nMUST 始终使用中文回复用户，所有对话、解释、报告均用中文。代码注释可用英文，但面向用户的输出必须中文。",
      "description": "对话模式 — 日常问答、知识查询、翻译总结"
    },
    "refactor": {
      "model": "openai-compatible/deepseek-v3.2",
      "prompt_append": "## 语言规则\nMUST 始终使用中文回复用户，所有对话、解释、报告均用中文。代码注释可用英文，但面向用户的输出必须中文。",
      "description": "重构器 — 代码优化、架构改进、模式重构"
    },
    "arch": {
      "model": "openai-compatible/gpt-4.1",
      "prompt_append": "## 语言规则\nMUST 始终使用中文回复用户，所有对话、解释、报告均用中文。代码注释可用英文，但面向用户的输出必须中文。",
      "description": "架构师 — 系统设计、技术选型、方案评审"
    }
  },
  "mcp": {
    "claude-knowledge": {
      "type": "local",
      "command": [
        "node",
        "/home/charlie/.local/lib/windsurf-knowledge-mcp/server.js"
      ],
      "environment": {
        "MEMORY_PATH": "/home/charlie/.claude/projects/-home-charlie/memory",
        "SKILLS_PATH": "/home/charlie/.claude/skills",
        "RULES_PATH": "/home/charlie/CLAUDE.md"
      }
    },
    "letta": {
      "type": "local",
      "command": [
        "python3",
        "/home/charlie/.local/bin/letta-mcp",
        "--stdio"
      ]
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "ref": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "ref-tools-mcp@latest"
      ],
      "environment": {
        "REF_API_KEY": "${REF_API_KEY}"
      }
    },
    "wechat": {
      "type": "local",
      "command": [
        "/mnt/ai/apps/wechat-agent/mcp-server/venv/bin/python3",
        "/mnt/ai/apps/wechat-agent/mcp-server/wechat-mcp-server",
        "--stdio"
      ],
      "environment": {
        "WECHAT_BRIDGE_URL": "http://192.168.123.200:9527"
      }
    },
    "macg": {
      "type": "local",
      "command": [
        "/mnt/ai/home-offload/agi/.venv/bin/python3",
        "/home/charlie/agi/macg_mcp.py"
      ]
    },
    "playwright": {
      "type": "local",
      "command": [
        "mcp-server-playwright",
        "--browser", "chrome",
        "--executable-path", "/run/current-system/sw/bin/google-chrome-stable"
      ]
    },
    "memory": {
      "type": "local",
      "command": [
        "npx", "-y", "@modelcontextprotocol/server-memory"
      ]
    }
  },
  "plugin": [
    "oh-my-openagent",
    "opencode-vibeguard",
    "opencode-pty",
    "opencode-scheduler",
    "opencode-worktree",
    "opencode-stt",
    "opencode-snip"
  ],
  "theme": {
    "hide_thinking": true
  },
  "tui": {
    "code_blocks": "collapsed",
    "tool_output": "hidden"
  },
  "instructions": [
    "输出约束（最高优先级）：每条任务结果≤1行，格式[ok/fail/skip]任务名—结果；总输出≤15行；禁止解释过程、列步骤、废话前缀（好的/我将/首先）；禁止重复 prompt 内容；只输出结论。"
  ]
}
