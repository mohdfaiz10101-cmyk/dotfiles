{
  "$schema": "https://opencode.ai/opencode.json",
  "provider": {
    "openai-compatible": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "sk-litellm-charlie-2026"
      },
      "models": {
        "deepseek-v3.2": {
          "name": "DeepSeek V3.2 (SiliconFlow)",
          "limit": {
            "context": 163840,
            "output": 8192
          }
        },
        "glm-5.1": {
          "name": "GLM-5.1 旗舰 (Z.AI)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm-5-turbo": {
          "name": "GLM-5-Turbo (Z.AI)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm-4.7": {
          "name": "GLM-4.7 (Z.AI)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm-4-plus": {
          "name": "GLM-4-Plus (Z.AI)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm-4.6v-flash": {
          "name": "GLM-4.6V-Flash 视觉 (Z.AI 免费)",
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "capabilities": {
            "vision": true
          }
        },
        "glm-4v-flash": {
          "name": "GLM-4V-Flash 视觉 (Z.AI 免费)",
          "limit": {
            "context": 16384,
            "output": 1024
          },
          "capabilities": {
            "vision": true
          }
        },
        "gpt-4.1": {
          "name": "GPT-4.1 (GitHub 免费)",
          "limit": {
            "context": 1047576,
            "output": 32768
          }
        },
        "qwen3-235b": {
          "name": "Qwen3-235B (SiliconFlow 免费)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "cerebras-llama-8b": {
          "name": "Cerebras Llama-8B (极速免费 <100ms)",
          "limit": {
            "context": 8192,
            "output": 4096
          }
        },
        "cerebras-qwen3-235b": {
          "name": "Cerebras Qwen3-235B (免费 MoE)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "cerebras-gpt-120b": {
          "name": "Cerebras GPT-120B (免费)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "macg": {
          "name": "MACG LangGraph (14工具+5流程+智能路由)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "openai-compatible/glm-5-turbo",
  "small_model": "openai-compatible/cerebras-llama-8b",
  "default_agent": "sisyphus",
  "agent": {
    "build": {
      "model": "openai-compatible/glm-5.1",
      "prompt_append": "## 语言规则\nMUST 始终使用中文回复用户，所有对话、解释、报告均用中文。\n## 防幻觉规则（死规则）\n不确定的事实直接说不确定。命令/路径/版本必须用工具验证，禁止凭记忆回答。不知道就说不知道，禁止编造。",
      "description": "代码构建器 — 代码生成、功能实现、测试编写"
    },
    "plan": {
      "model": "openai-compatible/glm-5.1",
      "prompt_append": "## 语言规则\nMUST 始终使用中文回复用户，所有对话、解释、报告均用中文。\n## 防幻觉规则（死规则）\n不确定的事实直接说不确定。命令/路径/版本必须用工具验证，禁止凭记忆回答。不知道就说不知道，禁止编造。",
      "description": "规划器 — 分析需求、生成可执行计划（Plan Mode）"
    },
    "explore": {
      "model": "openai-compatible/cerebras-llama-8b",
      "prompt_append": "## 语言规则\nMUST 始终使用中文回复用户，所有对话、解释、报告均用中文。代码注释可用英文，但面向用户的输出必须中文。\n## 防幻觉规则（死规则）\n不确定的事实直接说不确定。命令/路径必须用工具验证。不知道就说不知道，禁止编造。",
      "description": "代码搜索员 — 定位文件、函数、实现模式（Cerebras 极速）"
    },
    "chat": {
      "model": "openai-compatible/qwen3-235b",
      "prompt_append": "## 语言规则\nMUST 始终使用中文回复用户，所有对话、解释、报告均用中文。\n## 防幻觉规则（死规则）\n不确定的事实直接说不确定。不知道就说不知道，禁止编造。涉及系统状态先查再答。",
      "description": "对话模式 — 日常问答、知识查询、翻译总结"
    },
    "refactor": {
      "model": "openai-compatible/glm-5.1",
      "prompt_append": "## 语言规则\nMUST 始终使用中文回复用户，所有对话、解释、报告均用中文。\n## 防幻觉规则（死规则）\n不确定的事实直接说不确定。命令/路径/版本必须用工具验证，禁止凭记忆回答。不知道就说不知道，禁止编造。",
      "description": "重构器 — 代码优化、架构改进、模式重构"
    },
    "arch": {
      "model": "openai-compatible/gpt-4.1",
      "prompt_append": "## 语言规则\nMUST 始终使用中文回复用户，所有对话、解释、报告均用中文。\n## 防幻觉规则（死规则）\n不确定的事实直接说不确定。架构建议必须基于用户实际系统，不凭假设编造。不知道就说不知道。",
      "description": "架构师 — 系统设计、技术选型、方案评审"
    },
    "marketing-coordinator": {
      "model": "openai-compatible/glm-4-plus",
      "prompt_file": "/home/charlie/.config/opencode/agents/marketing-coordinator.md",
      "prompt_append": "## 语言规则\nMUST 始终使用中文回复用户。"
    },
    "marketing-auditor": {
      "model": "openai-compatible/glm-4-plus",
      "prompt_file": "/home/charlie/.config/opencode/agents/marketing-auditor.md",
      "prompt_append": "## 语言规则\nMUST 始终使用中文回复用户。"
    },
    "tech-architect": {
      "model": "openai-compatible/gpt-4.1",
      "prompt_file": "/home/charlie/.config/opencode/agents/tech-architect.md",
      "prompt_append": "## 语言规则\nMUST 始终使用中文回复用户。"
    },
    "tech-researcher": {
      "model": "openai-compatible/glm-4-plus",
      "prompt_file": "/home/charlie/.config/opencode/agents/tech-researcher.md",
      "prompt_append": "## 语言规则\nMUST 始终使用中文回复用户。"
    },
    "macg": {
      "model": "openai-compatible/macg",
      "description": "MACG 统一调度 — LangGraph 智能路由（GLM免费→Opus升级）+ 14工具 + 5工作流 + 实时系统感知 + 微信 + OP委托",
      "prompt_append": "你是 MACG LangGraph 统一调度器。你的回复已经过 GLM/Opus 处理，直接展示结果即可。"
    },
    "ops-dispatcher": {
      "model": "openai-compatible/glm-4-plus",
      "prompt_file": "/home/charlie/.config/opencode/agents/ops-dispatcher.md",
      "prompt_append": "## 语言规则\nMUST 始终使用中文回复用户。"
    }
  },
  "mcp": {
    "claude-knowledge": {
      "type": "local",
      "command": [
        "node",
        "/home/charlie/.local/lib/windsurf-knowledge-mcp/server.js"
      ],
      "environment": {
        "MEMORY_PATH": "/home/charlie/.claude/projects/-home-charlie/memory",
        "SKILLS_PATH": "/home/charlie/.claude/skills",
        "RULES_PATH": "/home/charlie/CLAUDE.md"
      }
    },
    "letta": {
      "type": "local",
      "command": [
        "python3",
        "/home/charlie/.local/bin/letta-mcp",
        "--stdio"
      ]
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "gmail": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@gongrzhe/server-gmail-autoauth-mcp"
      ],
      "environment": {
        "GMAIL_CREDENTIALS_PATH": "/home/charlie/.gmail-mcp/credentials.json",
        "GMAIL_OAUTH_PATH": "/home/charlie/.gmail-mcp/gcp-oauth.keys.json"
      }
    }
  },
  "plugin": [
    "oh-my-openagent",
    "opencode-vibeguard",
    "opencode-pty",
    "opencode-scheduler",
    "opencode-worktree",
    "opencode-stt",
    "opencode-snip"
  ],
  "theme": {
    "hide_thinking": true
  },
  "tui": {
    "code_blocks": "collapsed",
    "tool_output": "hidden"
  }
}