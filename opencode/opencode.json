  "mcp": {
    "letta": {
      "enabled": true,
      "type": "local",
      "command": [
        "python3",
        "/home/charlie/.local/bin/letta-mcp",
        "--stdio"
      ]
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "ref": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "ref-tools-mcp@latest"
      ],
      "environment": {
        "REF_API_KEY": "${REF_API_KEY}"
      }
    },
    "wechat": {
      "type": "local",
      "command": [
        "/mnt/ai/apps/wechat-agent/mcp-server/venv/bin/python3",
        "/mnt/ai/apps/wechat-agent/mcp-server/wechat-mcp-server",
        "--stdio"
      ],
      "environment": {
        "WECHAT_BRIDGE_URL": "http://192.168.123.200:9527"
      }
    },
    "macg": {
      "type": "local",
      "command": [
        "/mnt/ai/home-offload/agi/.venv/bin/python3",
        "/home/charlie/agi/macg_mcp.py"
      ]
    },
    "playwright": {
      "type": "local",
      "command": [
        "mcp-server-playwright",
        "--browser",
        "chrome",
        "--executable-path",
        "/run/current-system/sw/bin/google-chrome-stable"
      ]
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    }
  },
  "plugin": [
    "oh-my-openagent",
    "opencode-snip",
    "opencode-vibeguard",
    "opencode-pty",
    "opencode-scheduler"
  ],
  "experimental": {
    "continue_loop_on_deny": true
  },
  "theme": "dark",
  "hide_thinking": true,
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "ask",
      "sudo *": "ask",
      "chmod *": "ask",
      "mkfs *": "deny",
      "dd *": "deny"
    },
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow",
    "doom_loop": "ask",
    "skill": {
      "*": "allow"
    },
    "mcp": {
      "*": "allow"
    },
    "memory": "allow",
    "todo": "allow",
    "schedule": "allow"
  },
  "instructions": [
    "/home/charlie/Documents/memory/lessons.md",
    "/home/charlie/Documents/memory/lessons-nix.md",
    "/home/charlie/Documents/memory/context.md"
