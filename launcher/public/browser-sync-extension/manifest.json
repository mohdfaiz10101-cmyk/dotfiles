{
  "manifest_version": 3,
  "name": "MCP Browser Sync",
  "version": "1.0.0",
  "description": "本地 MCP 实时浏览器同步 - 书签、历史、标签、设置全同步",

  "permissions": [
    "bookmarks",
    "history",
    "tabs",
    "cookies",
    "storage",
    "webRequest"
  ],

  "host_permissions": [
    "http://localhost:9978/*",
    "http://192.168.123.1:9978/*",
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },

  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
